<Window x:Class="AetherSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aether Browser Setup" Height="560" Width="720" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="./Fonts/#Quicksand">
  <Window.Resources>
    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C7D0DC"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#4DA3FF"/>
          <Setter Property="Foreground" Value="#06121F"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#7DBDFF"/>
          <Setter Property="Foreground" Value="#06121F"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TitleX" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
      <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#4DA3FF"/>
          <Setter Property="Foreground" Value="#06121F"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#7DBDFF"/>
          <Setter Property="Foreground" Value="#06121F"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#10253F" Offset="0"/>
      <GradientStop Color="#0D2036" Offset="0.35"/>
      <GradientStop Color="#0A1728" Offset="0.7"/>
      <GradientStop Color="#060B14" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="#4DA3FF"/>
      <Setter Property="Foreground" Value="#06121F"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="26,9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#7DBDFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8A9BB3"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1A2A44"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavGhost" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8A9BB3"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="26,0"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1A2A44"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavAccent" TargetType="Button">
      <Setter Property="Background" Value="#4DA3FF"/>
      <Setter Property="Foreground" Value="#06121F"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="30,0"/>
      <Setter Property="Height" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#7DBDFF"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.35"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavDanger" TargetType="Button" BasedOn="{StaticResource NavAccent}">
      <Setter Property="Background" Value="#D63A3A"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E85454"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">      <Setter Property="Background" Value="#0A1526"/>
      <Setter Property="BorderBrush" Value="#23405F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="#23405F" CornerRadius="4" Width="8" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkTip" TargetType="ToolTip">
      <Setter Property="Background" Value="#14304D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#23405F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AcceptBox" TargetType="RadioButton">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="20" Height="20">
                <Ellipse Name="Ring" Stroke="#23405F" StrokeThickness="1.5"
                         Fill="#0A1526"/>
                <Ellipse Name="Dot" Width="10" Height="10" Fill="#4DA3FF"
                         Opacity="0"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                TextElement.FontSize="14" TextElement.Foreground="White"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="#7DBDFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="#4DA3FF"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Dot"
                                       Storyboard.TargetProperty="Opacity"
                                       From="0" To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Dot"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="20" Height="20">
                <Border Name="Box" Background="#0A1526" BorderBrush="#23405F"
                        BorderThickness="1.5" CornerRadius="5"/>
                <Path Name="Tick" Data="M5,10.5 L9,14.5 L15,6"
                      Stroke="#06121F" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Opacity="0"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                TextElement.Foreground="White"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#7DBDFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#4DA3FF"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#4DA3FF"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Tick"
                                       Storyboard.TargetProperty="Opacity"
                                       From="0" To="1" Duration="0:0:0.15"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Tick"
                                       Storyboard.TargetProperty="Opacity"
                                       To="0" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DirBox" TargetType="TextBox">
      <Setter Property="Background" Value="#0A1526"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#23405F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Cursor" Value="IBeam"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#7DBDFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="#4DA3FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#D63A3A"/>
      <Setter Property="Foreground" Value="White"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E85454"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="BoxBtn" TargetType="Button">
      <Setter Property="Background" Value="#0A1526"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#23405F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#4DA3FF"/>
          <Setter Property="Background" Value="#14304D"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#1E3A5C"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LangRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1A2A44"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#5D6B82"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Name="RootBorder" CornerRadius="16" Background="{StaticResource Bg}"
          BorderBrush="#23405F" BorderThickness="1" ClipToBounds="True">
    <Grid Name="ScaleRoot">
      <Grid.LayoutTransform>
        <ScaleTransform x:Name="ScaleAll" ScaleX="1" ScaleY="1"/>
      </Grid.LayoutTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

        <!-- barra propia -->
        <Grid Name="TitleBar" Grid.Row="0" Margin="20,0,0,0" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Name="BtnLang" Style="{StaticResource Chip}" Foreground="#C7D0DC"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                Click="BtnLang_Click">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       StrokeThickness="1.2"/>
              <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       StrokeThickness="1" Margin="3.5,1"/>
              <Line X1="1" X2="13" Y1="7" Y2="7"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1"/>
            </Grid>
            <TextBlock Name="LangCode" Text="English" FontSize="12" Foreground="#E8EDF3" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Name="BtnZoom" Style="{StaticResource Chip}" Foreground="#C7D0DC"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                Click="BtnZoom_Click">
          <Button.ToolTip>
            <ToolTip Name="TipZoom" Style="{StaticResource DarkTip}" Content="Zoom"/>
          </Button.ToolTip>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                     StrokeThickness="1.3"/>
            <Line X1="6" Y1="6" X2="11" Y2="11"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6"/>
          </Grid>
          <TextBlock Name="ZoomLbl" Text="Zoom" FontSize="12" Foreground="#E8EDF3" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="" FontSize="13" Foreground="White"
                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,0,0">
          <Button Name="BtnMin" Style="{StaticResource TitleBtn}" Click="BtnMin_Click"
                  Margin="0,0,0,0">
            <Button.ToolTip>
              <ToolTip Name="TipMin" Style="{StaticResource DarkTip}" Content="Minimize"/>
            </Button.ToolTip>
            <Path Data="M0,0 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  Width="10" Height="10" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
          <Popup Name="ZoomPop" PlacementTarget="{Binding ElementName=BtnZoom}"
                 Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                 PopupAnimation="Fade" VerticalOffset="8">
            <Border Style="{StaticResource Card}" Padding="6" MinWidth="130">
              <StackPanel>
                <Button Name="Zoom100" Content="100%" Style="{StaticResource LangRow}" Click="ZoomPick_Click"/>
                <Button Name="Zoom125" Content="125%" Style="{StaticResource LangRow}" Click="ZoomPick_Click"/>
                <Button Name="Zoom150" Content="150%" Style="{StaticResource LangRow}" Click="ZoomPick_Click"/>
              </StackPanel>
            </Border>
          </Popup>
          <Button Name="BtnX" Style="{StaticResource TitleX}" Click="BtnX_Click"
                  Margin="0,0,0,0">
            <Button.ToolTip>
              <ToolTip Name="TipX" Style="{StaticResource DarkTip}" Content="Close"/>
            </Button.ToolTip>
            <Path Data="M0,0 L9,9 M9,0 L0,9"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.2"
                  Width="10" Height="10" Stretch="None"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- P1 -->
      <StackPanel Name="P1" Grid.Row="1" Margin="36,4" VerticalAlignment="Center"
                  HorizontalAlignment="Center" MaxWidth="460">
        <Image Name="Logo" Height="168" HorizontalAlignment="Center" Margin="0,6,0,18"
               RenderOptions.BitmapScalingMode="HighQuality">
          <!-- No Effect here on purpose: a DropShadow halo (BlurRadius 30 at
               0.55 opacity) drowned the 118px logo and read as blurry. The mark
               is crisp on the dark background without it. -->
        </Image>
        <TextBlock Name="LogoFallback" Visibility="Collapsed"/>
        <TextBlock Name="WTit" Text="Aether Browser" FontSize="32" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Name="WSet" Text="S E T U P" FontSize="13" FontWeight="Bold" Foreground="#4DA3FF"
                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
        <Border Width="64" Height="3" CornerRadius="2" Background="#4DA3FF"
                HorizontalAlignment="Center" Margin="0,12,0,12"/>
        <TextBlock Name="WTag" Text="A private browser. Yours from the first click."
                   FontSize="14" Foreground="#8A9BB3"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Name="WVer" Text="Version 0.1" FontSize="12" Foreground="#8A9BB3"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <Popup Name="LangPop" PlacementTarget="{Binding ElementName=BtnLang}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" VerticalOffset="8">
          <Border Style="{StaticResource Card}" Padding="6" MinWidth="200">
            <StackPanel>
              <TextBlock Name="PopNote" FontSize="11" Foreground="#5D6B82"
                         Margin="12,4,12,6" TextWrapping="Wrap" MaxWidth="220"/>
              <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <StackPanel Name="LangMenu"/>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>

    <!-- P2 terms -->
      <StackPanel Name="P2" Grid.Row="1" Margin="36,28" VerticalAlignment="Stretch" Visibility="Collapsed">
        <TextBlock Name="TTit" Text="Terms of Use" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="TSub" Text="Please review and accept to continue." FontSize="14" Foreground="#8A9BB3" Margin="0,6,0,12"/>
        <Border CornerRadius="12" Background="#0C1A2E" BorderBrush="#23405F" BorderThickness="1"
                Padding="4" Margin="0,0,0,4">
          <RichTextBox Name="RtfTerms" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                       FontSize="13" Foreground="#C7D0DC" FontFamily="./Fonts/#Quicksand"
                       Background="Transparent" BorderThickness="0" Padding="10"
                       Height="260" VerticalContentAlignment="Top" IsDocumentEnabled="True"/>
        </Border>
        <RadioButton Name="ChkAccept" Content="I accept these terms" Style="{StaticResource AcceptBox}" Margin="0,12,0,0" GroupName="Terms"
                  Checked="ChkAccept_Changed" Unchecked="ChkAccept_Changed"/>
        <RadioButton Name="ChkDecline" Content="I do not accept these terms" Style="{StaticResource AcceptBox}" Margin="0,8,0,0" GroupName="Terms"
                  Checked="ChkDecline_Changed" Unchecked="ChkDecline_Changed"/>
      </StackPanel>

      <!-- P3 directory -->
      <StackPanel Name="P3" Grid.Row="1" Margin="36,28" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Name="DTit" Text="Install location" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="DSub" Text="Choose where to install Aether Browser." FontSize="14" Foreground="#8A9BB3" Margin="0,6,0,16"/>
        <DockPanel>
          <Button Name="BtnBrowse" Content="Browse..." Style="{StaticResource BoxBtn}" DockPanel.Dock="Right" Margin="8,0,0,0"
                  VerticalAlignment="Center" Click="BtnBrowse_Click"/>
        <TextBox Name="TxtDir" Text="C:\Program Files\Aether Browser" Style="{StaticResource DirBox}"
                 HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Name="LblSpace" Text="Space required: 370 MB" FontSize="12" Foreground="#8A9BB3" Margin="0,12,0,16"/>
        <CheckBox Name="ChkDesktop" Content="Create a desktop icon" IsChecked="True" Style="{StaticResource Check}"/>
      </StackPanel>

      <!-- P4 idioma -->
      <StackPanel Name="P4" Grid.Row="1" Margin="36,28" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Name="LTit" Text="Language" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="LSub" Text="Aether speaks English out of the box. Other languages download their language pack from Firefox during setup."
                   FontSize="14" Foreground="#8A9BB3" Margin="0,6,0,16" TextWrapping="Wrap"/>
        <!-- Rows are built in code (Langs.cs): flag + name. -->
        <ListBox Name="LstLang" SelectedIndex="0" Background="Transparent" BorderThickness="0" MaxHeight="188"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.PanningMode="VerticalOnly"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PreviewMouseWheel="LstLang_PreviewMouseWheel">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Background" Value="#0A1526"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter Property="Padding" Value="10,7"/>
              <Setter Property="Margin" Value="0,0,0,8"/>
              <Setter Property="BorderBrush" Value="#23405F"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="#7DBDFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#14304D"/>
                  <Setter Property="BorderBrush" Value="#4DA3FF"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </StackPanel>

      <!-- P5 progreso -->
      <StackPanel Name="P5" Grid.Row="1" Margin="36,28" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Name="PTit" Text="Installing..." FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="LblDetail" Text="Preparing..." FontSize="14" Foreground="#8A9BB3" Margin="0,6,0,16"/>
        <Border Name="TrackBar" Height="10" CornerRadius="5" Background="#0A1526">
          <Rectangle Name="Fill" Fill="#4DA3FF" RadiusX="5" RadiusY="5"
                     HorizontalAlignment="Left" Width="0"/>
        </Border>
        <TextBlock Name="LblPct" Text="0%" FontSize="12" Foreground="#8A9BB3" Margin="0,8,0,0"/>
      </StackPanel>

      <!-- P6 fin -->
      <StackPanel Name="P6" Grid.Row="1" Margin="36,28" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Name="FTit" Text="Done" FontSize="28" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="FSub" Text="Aether Browser 0.1 is installed." FontSize="15" Foreground="#8A9BB3" Margin="0,6,0,16"/>
        <Button Name="BtnOpen" Content="Open Aether Browser" Style="{StaticResource Btn}" HorizontalAlignment="Left" Padding="22,8" Click="BtnOpen_Click"/>
      </StackPanel>

      <!-- P7 scope -->
      <StackPanel Name="P7" Grid.Row="1" Margin="36,24" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Name="STit" Text="Who is this for?" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="SSub" Text="Choose who can use Aether on this PC." FontSize="14" Foreground="#8A9BB3" Margin="0,6,0,14"/>
        <RadioButton Name="RadUser" Content="Just me (Recommended)" Style="{StaticResource AcceptBox}" GroupName="Scope"
                   IsChecked="True" Checked="Scope_Changed" Margin="0,0,0,2"/>
        <StackPanel Margin="34,2,0,12">
          <TextBlock Name="SU1" Text="•  No administrator password needed." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
          <TextBlock Name="SU2" Text="•  Installs inside your own user folder, not in Program Files." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
          <TextBlock Name="SU3" Text="•  Only your Windows account will see it." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
          <TextBlock Name="SU4" Text="•  Updates install by themselves: since the browser lives in your own folder, Windows has nothing to approve." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
        </StackPanel>
        <RadioButton Name="RadSystem" Content="Everyone on this PC" Style="{StaticResource AcceptBox}" GroupName="Scope"
                   Checked="Scope_Changed" Margin="0,0,0,2"/>
        <StackPanel Margin="34,2,0,0">
          <TextBlock Name="SS1" Text="•  You will be asked for an administrator password during setup." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
          <TextBlock Name="SS2" Text="•  Installs once in Program Files and every Windows account can open it." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
          <TextBlock Name="SS3" Text="•  Each person keeps their own bookmarks and history." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
          <TextBlock Name="SS4" Text="•  Updates may show a permission prompt, because Program Files is a protected folder." FontSize="14" Foreground="#C7D0DC" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>

      <!-- P8 desinstalar -->
      <StackPanel Name="P8" Grid.Row="1" Margin="36,28" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock Name="UTit" Text="Remove Aether Browser" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <TextBlock Name="USub" Text="Choose what to delete. Nothing outside these items is touched." FontSize="14" Foreground="#8A9BB3" Margin="0,6,0,16" TextWrapping="Wrap"/>
        <CheckBox Name="UProg" Content="Program files" IsChecked="True" Style="{StaticResource Check}" Margin="0,0,0,8"/>
        <CheckBox Name="UProf" Content="Profile data" Style="{StaticResource Check}" Margin="0,0,0,8"/>
        <CheckBox Name="UShort" Content="Shortcuts" IsChecked="True" Style="{StaticResource Check}" Margin="0,0,0,8"/>
        <CheckBox Name="UReg" Content="File associations" IsChecked="True" Style="{StaticResource Check}" Margin="0,0,0,8"/>
        <Border Name="UTrack" Height="10" CornerRadius="5" Background="#0A1526" Margin="0,8,0,0" Visibility="Collapsed">
          <Rectangle Name="UFill" Fill="#4DA3FF" RadiusX="5" RadiusY="5" HorizontalAlignment="Left" Width="0"/>
        </Border>
        <TextBlock Name="ULbl" FontSize="12" Foreground="#8A9BB3" Margin="0,8,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Name="UBtnRemove" Content="Remove" Style="{StaticResource BtnDanger}" Padding="22,8" Click="UBtnRemove_Click"/>
          <Button Name="UBtnCancel" Content="Cancel" Style="{StaticResource Ghost}" Padding="22,8" Margin="8,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
      </StackPanel>

      <!-- nav pinned to the edge -->
      <DockPanel Name="Nav" Grid.Row="2" Margin="0" LastChildFill="False">
        <Button Name="BtnCancel" Content="Cancel" Style="{StaticResource NavGhost}" DockPanel.Dock="Left" Click="BtnCancel_Click"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Name="BtnBack" Content="&lt; Back" Style="{StaticResource NavGhost}" Click="BtnBack_Click"/>
          <Border Width="1" Background="#23405F" Margin="0,12"/>
          <Button Name="BtnNext" Content="Install &gt;" Style="{StaticResource NavAccent}" Click="BtnNext_Click"/>
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
