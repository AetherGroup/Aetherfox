# Aether Browser — mozconfig Windows x64 v1
# Usage: $env:MOZCONFIG="$PWD\mozconfig.windows" ; ./mach build
# Day-to-day dev: artifact build. Release: full build.
# IMPORTANT (the equivalent of Helium's flags.gn):
# do NOT define MOZ_TELEMETRY_REPORTING, MOZ_SERVICES_HEALTHREPORT or MOZILLA_OFFICIAL.
# That disables telemetry/reporting at build level, not just through prefs.
# See the long note further down for which of those three actually stops pings
# from leaving the machine: it is MOZILLA_OFFICIAL, not MOZ_TELEMETRY_REPORTING.

ac_add_options --enable-project=browser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-aether

# Target Windows x64 MSVC (mingw32 no longer supported in FF153+)
ac_add_options --target=x86_64-pc-windows-msvc

# App name (must match patches/core/01-base-product.patch)
# NOTE: it has to be `export`, mk_add_options does not reach configure.
#  - MOZ_APP_NAME=aether -> aether.exe, aether-* packages
#  - --with-app-basename=Aether -> Name in application.ini, its own profile,
#    remoting (does not collide with the Firefox profile).
export MOZ_APP_NAME=aether
ac_add_options --with-app-basename=Aether
ac_add_options --with-branding=browser/branding/aether

# Our own channel, never Mozilla's release/beta/nightly
ac_add_options --with-update-channel=aether-release

# MAR: the updater only accepts the channels listed here. Without this the
# local MAR (aether-release channel) is rejected with "failed".
export MAR_CHANNEL_ID=aether-release
export ACCEPTED_MAR_CHANNEL_IDS=aether-release

# Unsigned MAR (dev): make-mar-local.py generates unsigned MARs.
ac_add_options --enable-unverified-updates

# Build the stub installer too (setup-stub.exe): scripts/make-stub-offline.py
# packs it together with the full installer into the single-file offline setup
# (direct install UI, no wizard). Upstream only implies this on 32-bit official
# channels; we are 64-bit unofficial, so it is set explicitly.
export MOZ_STUB_INSTALLER=1

# Build without telemetry or health report (group 03-telemetry-kill):
#  - MOZ_TELEMETRY_REPORTING stays OFF (default=mozilla_official, we are unofficial)
#  - MOZ_SERVICES_HEALTHREPORT off (imply=False in browser/moz.configure)
#  - MOZILLA_OFFICIAL undefined
# Effect: no upload, no Data Collection UI, no Shield Studies.
#
# NOTE: the guarantee is not the first bullet. MOZ_TELEMETRY_REPORTING only
# compiles the legacy telemetry code out. What actually stops pings leaving the
# machine is the chain
#   not MOZILLA_OFFICIAL  ->  gkrust feature glean_disable_upload
#     ->  glean/src/init/viaduct_uploader.rs returns a fake HTTP 200
#         without touching the network.
# MOZILLA_OFFICIAL was settable from the environment (81 files read it), so
# patch 03 pins mozilla_official() to False in build/moz.configure/init.configure.
# Do not reintroduce `if official: return True` there. verify-flags.py fails if
# either half of the chain is missing.

# No crash reporter in v1 (group 03): zero crash traffic.
ac_add_options --disable-crashreporter

# Acceleration (recommended)
# mk_add_options AUTOCLOBBER=1
# sccache PARKED: it flakes with "unable to open output file '-'" on clang-cl
# (every green build so far was without it). Revisit later.
# ac_add_options --with-ccache=sccache

# Artifact build for fast UI/prefs iteration (uncomment in dev):
# ac_add_options --enable-artifact-builds
