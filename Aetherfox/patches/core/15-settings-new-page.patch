+syncProtectionSection();
+// Deep-linkable sections (about:aethersettings#shield, optionally with
+// /<profile> to open one disclosure: #shield/custom). Unknown or missing
+// hashes land on the dashboard exactly as before.
+// Short section aliases: about:aethersettings#strictfingerprint opens the
+// Protection panel with the Strict list expanded (same for standard).
+const ALIASES = {
+  standardfingerprint: ["shield", "standard"],
+  strictfingerprint: ["shield", "strict"],
+};
+const [deepSection, deepDetail] = location.hash.replace(/^#/, "").split("/");
+const aliased = ALIASES[deepSection];
+const section = aliased ? aliased[0] : deepSection;
+const detail = aliased ? aliased[1] : deepDetail;
+show(section && SECTIONS[section] ? section : "panel");
+if (detail && ["standard", "strict", "custom"].includes(detail)) {
+  setOpenExclusive(detail);
+}
