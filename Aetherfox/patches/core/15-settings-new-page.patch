+function dragify(el, onMove, onDone) {
+  el.addEventListener("pointerdown", e => {
+    e.preventDefault();
+    el.setPointerCapture(e.pointerId);
+    onMove(e);
+    const move = ev => onMove(ev);
+    const up = () => {
+      el.removeEventListener("pointermove", move);
+      el.removeEventListener("pointerup", up);
+      el.removeEventListener("pointercancel", up);
+      if (onDone) {
+        onDone();
+      }
+    };
+    el.addEventListener("pointermove", move);
+    el.addEventListener("pointerup", up);
+    el.addEventListener("pointercancel", up);
+  });
+}
+
+dragify(
+  document.getElementById("svBox"),
+  e => {
+    const [x, y] = pickerPoint(e.currentTarget, e.clientX, e.clientY);
+    pickerState.s = x;
+    pickerState.v = 1 - y;
+    paintPicker();
+    pickerLive();
+  },
+  () => pickerCommit()
+);
+
+dragify(
+  document.getElementById("hueBar"),
+  e => {
+    const [x] = pickerPoint(e.currentTarget, e.clientX, e.clientY);
+    pickerState.h = x * 360;
+    paintPicker();
+    pickerLive();
+  },
+  () => pickerCommit()
+);
+
+document.getElementById("svBox").addEventListener("keydown", e => {
+  const step = e.shiftKey ? 0.1 : 0.03;
+  if (e.key === "ArrowLeft") {
+    pickerState.s = Math.max(0, pickerState.s - step);
+  } else if (e.key === "ArrowRight") {
+    pickerState.s = Math.min(1, pickerState.s + step);
+  } else if (e.key === "ArrowUp") {
+    pickerState.v = Math.min(1, pickerState.v + step);
+  } else if (e.key === "ArrowDown") {
+    pickerState.v = Math.max(0, pickerState.v - step);
+  } else {
+    return;
+  }
+  e.preventDefault();
+  paintPicker();
+  pickerCommit();
+});
+
+document.getElementById("hueBar").addEventListener("keydown", e => {
+  const step = e.shiftKey ? 10 : 3;
+  if (e.key === "ArrowLeft") {
+    pickerState.h = (pickerState.h - step + 360) % 360;
+  } else if (e.key === "ArrowRight") {
+    pickerState.h = (pickerState.h + step) % 360;
+  } else {
+    return;
+  }
+  e.preventDefault();
+  paintPicker();
+  pickerCommit();
+});
+
+// Commit as soon as a full, valid hex is typed. Incomplete input is left
+// alone so it can keep being typed; only on blur is it snapped back.
+document.getElementById("accentHex").addEventListener("input", e => {
+  let v = e.target.value.trim();
+  if (!v.startsWith("#")) {
+    v = "#" + v;
+  }
+  if (/^#[0-9a-fA-F]{6}$/.test(v)) {
+    const [h, s, vv] = hexToHsv(v.toUpperCase());
+    pickerState.h = h;
+    pickerState.s = s;
+    pickerState.v = vv;
+    paintPicker();
+    pickerCommit();
+  }
+});
+
+document.getElementById("accentHex").addEventListener("change", e => {
+  let v = e.target.value.trim();
+  if (!v.startsWith("#")) {
+    v = "#" + v;
+  }
+  if (!/^#[0-9a-fA-F]{6}$/.test(v)) {
+    e.target.value = currentAccent.startsWith("#")
+      ? currentAccent.replace("#", "")
+      : ACCENTS[currentAccent][0].replace("#", "");
+  }
+});
+
+document.getElementById("designRestartBtn").addEventListener("click", () => {
+  restartBrowser();
+});
+
+document.addEventListener("keydown", e => {
+  if (e.key === "Escape" && pickerState.open) {
+    e.preventDefault();
+    cancelPicker();
+  }
+});
+
+document.addEventListener("pointerdown", e => {
+  if (
+    pickerState.open &&
+    !e.target.closest("#accentPicker") &&
+    !e.target.closest("#accentCustomBtn")
+  ) {
+    closePicker();
+  }
+});
+
+
+applyTheme(getTheme(), false);
+applyAccent(getAccent(), false);
+applyWebScheme(getWebScheme(), false);
+applyDesign(getDesign(), false);
