+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+/* Aether settings behavior (unit 137): section switching plus the browser
+ * color picker. Runs chrome-privileged: the theme choice persists in the
+ * aether.settings.theme pref so it survives restarts and later drives the
+ * browser chrome as well. */
+"use strict";
+
+const INFO = {
+  panel: ["Dashboard", "Control center", "Jump quickly to the areas of the browser that matter most."],
+  look: ["Appearance", "Look and feel", "Theme and visual style of Aether."],
+  tabs: ["Tabs", "Tabs", "Browsing behavior and organization."],
+  spaces: ["Spaces", "Spaces", "Group tabs by context."],
+  start: ["Start", "Start", "What you see when Aether opens."],
+  shield: ["Protection", "Protection", "Privacy, tracking, cookies and permissions."],
+  perm: ["Permissions", "Permissions", "Camera, location and notifications per site."],
+  cookie: ["Cookies", "Cookies", "Which sites may store data."],
+  key: ["Passwords", "Passwords", "Saved credentials and autofill."],
+  perf: ["Performance", "Performance", "Memory, sleeping tabs and acceleration."],
+  upd: ["Updates", "Updates", "Aether versions and news."],
+  adv: ["Advanced", "Advanced", "Options for experienced users."],
+};
+// Sections with real content; anything else shows the stub.
+const SECTIONS = { look: "panel-appearance", shield: "panel-shield" };
+// Swap generation: stale fade callbacks from a superseded switch bail out.
+let swapGen = 0;
+const THEME_NAMES = { light: "Light", dark: "Dark", purple: "Purple", black: "Black", aetherlight: "Aether Light", aetherdark: "Aether Dark" };
+const THEME_ADDONS = {
+  light: "firefox-compact-light@mozilla.org",
+  dark: "firefox-compact-dark@mozilla.org",
+  purple: "aether-purple@aether.browser",
+  black: "aether-black@aether.browser",
+  aetherlight: "aether-light@aether.browser",
+  aetherdark: "aether-dark@aether.browser",
+};
+const THEME_PREF = "aether.settings.theme";
+const WEB_PREF = "layout.css.prefers-color-scheme.content-override";
+const WEB_NAMES = { 2: "system", 1: "light", 0: "dark" };
+const DESIGN_PREF = "aether.ui.design";
+
+// Every setting Aether adds is declared once in the registry; this page
+// renders from it so it can never fall behind about:preferences.
+const { AETHER_GROUPS, AETHER_MASTER } = ChromeUtils.importESModule(
+  "resource://gre/modules/AetherSettingsDefs.sys.mjs"
+);
+
+function readPref(name, def) {
+  try {
+    return Services.prefs.getBoolPref(name, def);
+  } catch (e) {
+    return def;
+  }
+}
+
+function setPref(name, value) {
+  try {
+    Services.prefs.setBoolPref(name, value);
+  } catch (e) {}
+}
+
+// Protection profiles: one radio each for Standard (safe layers on,
+// Strict ones off), Strict (everything on) and Custom (hand-picked).
+// Each radio expands to show what it includes; only Custom carries
+// working toggles, since the other two are fully described by their
+// selection. The master keeps its own card above: it is a global switch,
+// not a profile.
+const PROFILES = [
+  {
+    id: "standard",
+    title: "Standard",
+    desc: "Safe, reliable layers that work smoothly with most websites.",
+  },
+  {
+    id: "strict",
+    title: "Strict",
+    desc: "Stronger hiding that can break websites using the feature.",
+  },
+  {
+    id: "custom",
+    title: "Custom",
+    desc: "Choose exactly which layers to use.",
+  },
+];
+
+// Groups consumed by the profile radios above; the generic loop below
+// renders the rest (blocking, stock opt-ins) untouched.
+const PROFILE_GROUP_IDS = new Set(["protections", "strict"]);
+
+function buildProtectionSection() {
+  const host = document.getElementById("aetherGroups");
+  if (!host) {
+    return;
+  }
+  const all = AETHER_GROUPS.flatMap(g => g.settings);
+  const master = all.find(s => s.master);
+  if (master) {
+    const sec = document.createElement("section");
+    sec.className = "sec sec-master";
+    const card = document.createElement("div");
+    card.className = "card";
+    card.appendChild(buildMasterRow(master));
+    sec.appendChild(card);
+    host.appendChild(sec);
+  }
+  host.appendChild(buildProfilesCard());
+  for (const group of AETHER_GROUPS) {
+    if (PROFILE_GROUP_IDS.has(group.id)) {
+      continue;
+    }
+    const layers = group.settings.filter(s => !s.master);
+    if (!layers.length) {
+      continue;
+    }
+    const sec = document.createElement("section");
+    sec.className = "sec";
+    const h = document.createElement("h3");
+    h.textContent = group.title;
+    sec.appendChild(h);
+    if (group.description) {
+      const p = document.createElement("p");
+      p.textContent = group.description;
+      sec.appendChild(p);
+    }
+    const card = document.createElement("div");
+    card.className = "card";
+    for (const s of layers) {
+      card.appendChild(buildLayerRow(s));
+    }
+    sec.appendChild(card);
+    host.appendChild(sec);
+  }
+}
+
+function buildProfilesCard() {
+  const sec = document.createElement("section");
+  sec.className = "sec sec-profiles";
+  const card = document.createElement("div");
+  card.className = "card";
+  card.id = "profileCard";
+  for (const p of PROFILES) {
+    card.appendChild(buildProfileRow(p));
+    card.appendChild(buildProfileDetails(p));
+  }
+  sec.appendChild(card);
+  return sec;
+}
+
+function buildProfileRow(p) {
+  const row = document.createElement("div");
+  row.className = "row prof-row";
+  const lab = document.createElement("label");
+  lab.className = "prof-main";
+  const radio = document.createElement("input");
+  radio.type = "radio";
+  radio.name = "aether-profile";
+  radio.value = p.id;
+  radio.className = "prof-radio";
+  radio.addEventListener("change", () => {
+    // Accordion: selecting a profile opens its list and closes the rest.
+    setOpenExclusive(p.id);
+    if (p.id !== "custom") {
+      applyProfile(p.id);
+    }
+  });
+  const t = document.createElement("div");
+  t.className = "t";
+  const b = document.createElement("b");
+  b.textContent = p.title;
+  const sm = document.createElement("small");
+  sm.textContent = p.desc;
+  t.appendChild(b);
+  t.appendChild(sm);
