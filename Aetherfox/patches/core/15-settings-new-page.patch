 #include "mozilla/dom/MediaDevices.h"
+#include "mozilla/dom/AetherCanvasNoise.h"
 
 #include "AudioDeviceInfo.h"
 #include "MediaEngine.h"
@@ -392,6 +393,63 @@ RefPtr<MediaDeviceSetRefCnt> MediaDevices::FilterExposedDevices(
     }
   }
 
+  // Aether media-device shield (opt-in Strict layer): pages see one generic
+  // device per listed kind, so hardware ownership, model names and stable
+  // ids stay hidden. Only kinds already exposed are replaced, so the
+  // pre-permission shape is unchanged (no mics or cameras appear early).
+  // Permission prompts and capture keep working on the raw list, which
+  // lives on a different path; device pickers on sites will show a single
+  // generic entry each. Per-site exempt prefs restore the real list.
+  if (Preferences::GetBool("aether.fingerprinting.enabled", true) &&
+      Preferences::GetBool("aether.fingerprinting.mediaDevices", false)) {
+    bool exempt = false;
+    if (nsIPrincipal* principal = doc->NodePrincipal()) {
+      exempt = AetherCanvasNoise::SiteExempted(
+          principal, AetherCanvasNoise::TopKeyPrincipal(doc), "devices");
+    }
+    if (!exempt) {
+      bool haveMic = false;
+      bool haveCam = false;
+      bool haveSpk = false;
+      for (const auto& device : *exposed) {
+        if (device->mKind == MediaDeviceKind::Audioinput) {
+          haveMic = true;
+        } else if (device->mKind == MediaDeviceKind::Videoinput) {
+          haveCam = true;
+        } else if (device->mKind == MediaDeviceKind::Audiooutput) {
+          haveSpk = true;
+        }
+        // Avoid `default:` so that `-Wswitch` catches missing enumerators
+        // at compile time.
+      }
+      if (haveMic || haveCam || haveSpk) {
+        exposed->Clear();
+        RefPtr<MediaEngine> fakeEngine = new MediaEngineFake();
+        if (haveMic) {
+          exposed->AppendElement(new MediaDevice(
+              fakeEngine.get(), MediaSourceEnum::Microphone, u"Microphone"_ns,
+              u""_ns, u""_ns, MediaDevice::IsScary::No,
+              MediaDevice::OsPromptable::No));
+        }
+        if (haveCam) {
+          exposed->AppendElement(new MediaDevice(
+              fakeEngine.get(), MediaSourceEnum::Camera, u"Camera"_ns, u""_ns,
+              u""_ns, MediaDevice::IsScary::No,
+              MediaDevice::OsPromptable::No));
+        }
+        if (haveSpk) {
+          RefPtr info = new AudioDeviceInfo(
+              nullptr, u"Speaker"_ns, u""_ns, u""_ns,
+              CUBEB_DEVICE_TYPE_OUTPUT, CUBEB_DEVICE_STATE_ENABLED,
+              CUBEB_DEVICE_PREF_ALL, CUBEB_DEVICE_FMT_ALL,
+              CUBEB_DEVICE_FMT_S16NE, 2, 44100, 44100, 44100, 128, 128);
+          exposed->AppendElement(
+              new MediaDevice(fakeEngine.get(), info, u""_ns));
+        }
+      }
+    }
+  }
+
   return exposed;
 }
 
