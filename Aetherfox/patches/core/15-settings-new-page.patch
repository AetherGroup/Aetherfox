+document.querySelector(".sidebar").addEventListener(
+  "wheel",
+  e => {
+    const bar = e.currentTarget;
+    const dy = e.deltaMode ? e.deltaY * 16 : e.deltaY;
+    const canDown = bar.scrollTop + bar.clientHeight < bar.scrollHeight - 1;
+    const canUp = bar.scrollTop > 0;
+    if ((dy > 0 && canDown) || (dy < 0 && canUp)) {
+      wheelAcc = 0;
+      return;
+    }
+    e.preventDefault();
+    const now = performance.now();
+    if (now - wheelCool < WHEEL_COOL_MS) {
+      return;
+    }
+    wheelAcc += dy;
+    if (Math.abs(wheelAcc) < WHEEL_NOTCH) {
+      return;
+    }
+    const dir = wheelAcc > 0 ? 1 : -1;
+    wheelAcc = 0;
+    const items = [...document.querySelectorAll(".nav-item")].filter(
+      b => !b.hidden
+    );
+    const cur = items.findIndex(b => b.classList.contains("active"));
+    const next = Math.min(items.length - 1, Math.max(0, cur + dir));
