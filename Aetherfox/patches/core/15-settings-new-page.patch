diff --git a/dom/media/MediaDevices.cpp b/dom/media/MediaDevices.cpp
index 5c4939eca52749abd1272075d2e92e5294ba15d0..00f261b6cba23da24cb02b6dc5fb0280bd7b162f 100644
--- a/dom/media/MediaDevices.cpp
