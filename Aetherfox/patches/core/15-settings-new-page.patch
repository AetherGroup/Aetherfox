+      return true;
+    }
+    let base = host;
+    try {
+      base = Services.eTLD.getBaseDomainFromHost(host);
+    } catch (e) {}
+    if (
+      Services.prefs.getBoolPref(
+        "aether.fingerprinting.exempt.all." + base,
+        false
+      ) ||
+      Services.prefs.getBoolPref(
+        "aether.fingerprinting.exempt.devices." + base,
+        false
+      )
+    ) {
+      return false;
+    }
+    return true;
+  } catch (e) {
+    return false;
+  }
+}
