diff --git a/toolkit/modules/AetherGeometryShield.sys.mjs b/toolkit/modules/AetherGeometryShield.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..251f9bcf759883a205966f486aee501d5330ad74
--- /dev/null
+++ b/toolkit/modules/AetherGeometryShield.sys.mjs
@@ -0,0 +1,127 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * AetherGeometryShield: Strict opt-in window-geometry layer.
+ *
+ * There is no engine of its own here: the stock machinery already does
+ * everything, split in two halves that must move together -
+ * RFPHelper.sys.mjs rounds the content area to bucketed sizes when
+ * privacy.resistFingerprinting.letterboxing is on (it keys off that bool
+ * alone, no RFP needed), and the FPP target ScreenRect/ScreenAvailRect
+ * makes screen.* report the content rect instead of the real monitor.
+ * This module owns those three stock prefs and mirrors one verdict into
+ * them: master plus the geometry kill pref. Anything else touching the
+ * stock prefs (hand edits, remote FPP config) is rewritten on the next
+ * notification, so the three can never disagree with the toggle.
+ *
+ * Off restores the stock defaults (letterboxing off, FPP off, empty
+ * overrides). Per-site exemption does NOT lift geometry: FPP targets are
+ * FPP-owned and this bridge cannot scope them per site. Documented
+ * residual, same as service workers (no document on their creation path).
+ * Takes effect for new page loads; the panel already asks for a reload.
+ */
+
+// Services and ChromeUtils are globals in system modules.
+
+const PREF_MASTER = "aether.fingerprinting.enabled";
+const PREF_GEOMETRY = "aether.fingerprinting.geometry";
+const PREF_LETTERBOX = "privacy.resistFingerprinting.letterboxing";
+const PREF_FPP = "privacy.fingerprintingProtection";
+const PREF_OVERRIDES = "privacy.fingerprintingProtection.overrides";
+const TOPIC_PROFILE_END = "profile-before-change";
+
+// ScreenRect + ScreenAvailRect + WindowOuterSize only: every other target
+// stays off, so the rest of the browser keeps stock values with RFP
+// otherwise disabled. WindowOuterSize is load-bearing here, not a bonus:
+// it is the target that keeps the spoofed inner size fed from the visible
+// area (nsPresContext::UpdateInnerSizeSpoofedForRFP), which screen.* then
+// reports; it also makes outerWidth/outerHeight report the same bucket.
+const OVERRIDES_ON = "-AllTargets,+ScreenRect,+ScreenAvailRect,+WindowOuterSize";
+
+const OWNED_PREFS = [
+  PREF_MASTER,
+  PREF_GEOMETRY,
+  PREF_LETTERBOX,
+  PREF_FPP,
+  PREF_OVERRIDES,
+];
+
+export const AetherGeometryShield = {
+  QueryInterface: ChromeUtils.generateQI(["nsIObserver"]),
+
+  _applying: false,
+
+  init() {
+    for (const pref of OWNED_PREFS) {
+      Services.prefs.addObserver(pref, this);
+    }
+    Services.obs.addObserver(this, TOPIC_PROFILE_END);
+    this.apply();
+  },
+
+  uninit() {
+    for (const pref of OWNED_PREFS) {
+      try {
+        Services.prefs.removeObserver(pref, this);
+      } catch (e) {}
+    }
+    try {
+      Services.obs.removeObserver(this, TOPIC_PROFILE_END);
+    } catch (e) {}
+  },
+
+  observe(subject, topic) {
+    if (topic === TOPIC_PROFILE_END) {
+      this.uninit();
+      return;
+    }
+    this.apply();
+  },
+
+  effective() {
+    try {
+      return (
+        Services.prefs.getBoolPref(PREF_MASTER, true) &&
+        Services.prefs.getBoolPref(PREF_GEOMETRY, false)
+      );
+    } catch (e) {
+      return false;
+    }
+  },
+
+  apply() {
+    if (this._applying) {
+      return;
+    }
+    const on = this.effective();
+    let cur;
+    try {
+      cur = {
+        letterbox: Services.prefs.getBoolPref(PREF_LETTERBOX, false),
+        fpp: Services.prefs.getBoolPref(PREF_FPP, false),
+        overrides: Services.prefs.getStringPref(PREF_OVERRIDES, ""),
+      };
+    } catch (e) {
+      return;
+    }
+    const want = on
+      ? { letterbox: true, fpp: true, overrides: OVERRIDES_ON }
+      : { letterbox: false, fpp: false, overrides: "" };
+    if (
+      cur.letterbox === want.letterbox &&
+      cur.fpp === want.fpp &&
+      cur.overrides === want.overrides
+    ) {
+      return;
+    }
+    this._applying = true;
+    try {
+      Services.prefs.setBoolPref(PREF_LETTERBOX, want.letterbox);
+      Services.prefs.setBoolPref(PREF_FPP, want.fpp);
+      Services.prefs.setStringPref(PREF_OVERRIDES, want.overrides);
+    } catch (e) {}
+    this._applying = false;
+  },
+};
diff --git a/toolkit/modules/AetherSettingsDefs.sys.mjs b/toolkit/modules/AetherSettingsDefs.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..8eb8a85a3f2856a09b682cca5fadeeaff3435eef
--- /dev/null
+++ b/toolkit/modules/AetherSettingsDefs.sys.mjs
@@ -0,0 +1,247 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Single declaration of every setting Aether adds to the browser, so the
+// two settings UIs can never drift apart: about:aethersettings renders from
+// this list, and about:preferences keeps its declarative XUL bindings but
+// asserts the same set (see aether-settings-parity.js).
+//
+// Adding a setting means adding one entry here and binding it on both sides.
+// Nothing in this file touches the engine; it is data only.
+
+const PROTECTIONS = [
+  {
+    id: "fingerprinting",
+    pref: "aether.fingerprinting.enabled",
+    default: true,
+    master: true,
+    l10n: "aether-master-label",
+    label: "Fingerprinting protections",
+    description:
+      "Main switch for everything below. Turning it off restores normal " +
+      "behavior everywhere; blocking stays separate.",
+  },
+  {
+    id: "canvas",
+    pref: "aether.fingerprinting.canvasNoise2d",
+    default: true,
+    l10n: "aether-canvas-label",
+    label: "Canvas privacy",
+    description:
+      "Sites see slightly altered pixels, so they can't recognize your " +
+      "device. Everything looks the same to you.",
+  },
+  {
+    id: "webgl",
+    pref: "aether.fingerprinting.webglNoise",
+    default: true,
+    l10n: "aether-webgl-label",
+    label: "3D graphics privacy",
+    description:
+      "Sites see a common graphics card instead of yours. 3D and videos " +
+      "keep working.",
+  },
+  {
+    id: "audio",
+    pref: "aether.fingerprinting.audioNoise",
+    default: true,
+    l10n: "aether-audio-label",
+    label: "Audio privacy",
+    description:
+      "Sites get slightly altered sound data. You hear no difference.",
+  },
+  {
+    id: "samplerate",
+    pref: "aether.fingerprinting.audioSampleRate",
+    default: true,
+    l10n: "aether-samplerate-label",
+    label: "Common sample rate",
+    description: "Sites always see 44100 Hz instead of your device's rate.",
+  },
+  {
+    id: "cores",
+    pref: "aether.fingerprinting.hardwareConcurrency",
+    default: true,
+    l10n: "aether-cores-label",
+    label: "8 CPU cores",
+    description: "Sites see 8 cores instead of your real processor.",
+  },
+  {
+    id: "text",
+    pref: "aether.fingerprinting.textMetrics",
+    default: true,
+    l10n: "aether-text-label",
+    label: "Text measuring privacy",
+    description: "Tiny tweaks stop font sniffing. Text looks identical.",
+  },
+  {
+    id: "fonts",
+    pref: "aether.fingerprinting.fonts",
+    default: true,
+    l10n: "aether-fonts-label",
+    label: "Standard system fonts",
+    description: "Sites see the base set only, not your full collection.",
+  },
+  {
+    id: "languages",
+    pref: "aether.fingerprinting.languages",
+    default: true,
+    l10n: "aether-languages-label",
+    label: "Single language",
+    description: "Sites see one language instead of your whole list.",
+  },
+  {
+    id: "depth",
+    pref: "aether.fingerprinting.screenDepth",
+    default: true,
+    l10n: "aether-screen-depth-label",
+    label: "Standard color depth",
+    description: "Sites always see 24-bit color.",
+  },
+];
+
+// Strict layers: functionality the page can depend on, so turning one on
+// can break websites that use it. Same master gating as the standard
+// layers; defaults stay exactly as before (touch/gamepads/sensors on,
+// timezone/devices/geometry opt-in off).
+const STRICT = [
+  {
+    id: "touch",
+    pref: "aether.fingerprinting.touchPoints",
+    default: false,
+    l10n: "aether-touch-points-label",
+    label: "Hidden touch points",
+    description: "Sites won't know you have a touchscreen.",
+  },
+  {
+    id: "timezone",
+    pref: "aether.fingerprinting.timezoneUTC",
+    default: false,
+    l10n: "aether-timezone-label",
+    label: "UTC clock",
+    description:
+      "Sites see UTC instead of your local time. Hours may look wrong.",
+  },
+  {
+    id: "devices",
+    pref: "aether.fingerprinting.mediaDevices",
+    default: false,
+    l10n: "aether-devices-label",
+    label: "Generic camera and microphone",
+    description:
+      "Sites see one generic device. Calls work; site device lists " +
+      "won't match.",
+  },
+  {
+    id: "gamepads",
+    pref: "aether.fingerprinting.gamepads",
+    default: false,
+    l10n: "aether-gamepads-label",
+    label: "Hidden game controllers",
+    description: "Sites see no controllers. Controller games won't work.",
+  },
+  {
+    id: "sensors",
+    pref: "aether.fingerprinting.sensors",
+    default: false,
+    l10n: "aether-sensors-label",
+    label: "No motion sensors",
+    description:
+      "Sites get no movement data. Motion features won't work.",
+  },
+  {
+    id: "geometry",
+    pref: "aether.fingerprinting.geometry",
+    default: false,
+    l10n: "aether-geometry-label",
+    label: "Letterboxed windows",
+    description:
+      "Windows snap to common sizes with visible margins. Turn off if " +
+      "a site looks broken.",
+  },
+];
+
+// Kept separate on purpose: blocking survives the master going off, so it
+// must not read as one of the noise layers above.
+const BLOCKING = [
+  {
+    id: "blockFingerprinters",
+    pref: "aether.blockKnownFingerprinters",
+    default: true,
+    l10n: "aether-known-fingerprinters-label",
+    label: "Block known fingerprinters",
+    description:
+      "Blocks scripts and embeds from known fingerprinting providers " +
+      "before they load.",
+  },
+];
+
+// Stock switches we expose rather than own: turning them on removes a
+// protection, which is why they default off and sit in their own group.
+const OPT_INS = [
+  {
+    id: "webgpu",
+    pref: "dom.webgpu.enabled",
+    default: false,
+    stock: true,
+    l10n: "aether-webgpu-label",
+    label: "Allow WebGPU",
+    description:
+      "Lets pages use WebGPU, exposing graphics adapter details. Off by " +
+      "default.",
+  },
+  {
+    id: "uaToken",
+    pref: "general.useragent.showAppToken",
+    default: false,
+    stock: true,
+    l10n: "aether-ua-token-label",
+    label: "Include the Aether token in the user agent",
+    description:
+      "Identifies the browser as Aether instead of stock Firefox. Off by " +
+      "default.",
+  },
+];
+
+export const AETHER_GROUPS = Object.freeze([
+  Object.freeze({
+    id: "protections",
+    gated: true,
+    title: "Standard fingerprinting protections",
+    description:
+      "Quiet layers that never break websites. Each switch takes effect " +
+      "for new page loads.",
+    settings: Object.freeze(PROTECTIONS),
+  }),
+  Object.freeze({
+    id: "strict",
+    gated: true,
+    title: "Strict fingerprinting protections",
+    description:
+      "These can break websites that use the feature. Turn one off if " +
+      "a site stops working.",
+    settings: Object.freeze(STRICT),
+  }),
+  Object.freeze({
+    id: "blocking",
+    title: "Network blocking",
+    settings: Object.freeze(BLOCKING),
+  }),
+  Object.freeze({
+    id: "optIns",
+    title: "Stock features we leave off",
+    settings: Object.freeze(OPT_INS),
+  }),
+]);
+
+export const AETHER_SETTINGS = Object.freeze(
+  AETHER_GROUPS.flatMap(g => g.settings),
+);
+
+export const AETHER_MASTER = AETHER_SETTINGS.find(s => s.master);
+
+/** Prefs gated by the master: every non-stock setting outside the master. */
+export const AETHER_GATED = Object.freeze(
+  AETHER_SETTINGS.filter(s => AETHER_MASTER.pref !== s.pref && !s.stock),
+);
diff --git a/toolkit/modules/AetherUiDesign.sys.mjs b/toolkit/modules/AetherUiDesign.sys.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..95761982c3c9f2013754e309b51fc20291cc0ccc
--- /dev/null
+++ b/toolkit/modules/AetherUiDesign.sys.mjs
@@ -0,0 +1,40 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Which settings interface the user sees. Every redesigned surface checks
+// this at its entry point and falls back to the stock implementation when
+// the user chose Firefox. The default lives here in code (implicit "aether")
+// with an explicit user value persisted in the pref; surfaces read through
+// getDesign() so they never branch on the raw pref themselves.
+
+// Services is a global in system modules.
+const DESIGN_PREF = "aether.ui.design";
+const DESIGN_AETHER = "aether";
+const DESIGN_FIREFOX = "firefox";
+
+export const AetherUiDesign = {
+  PREF: DESIGN_PREF,
+  AETHER: DESIGN_AETHER,
+  FIREFOX: DESIGN_FIREFOX,
+
+  getDesign() {
+    try {
+      const v = Services.prefs.getStringPref(DESIGN_PREF);
+      return v === DESIGN_FIREFOX ? DESIGN_FIREFOX : DESIGN_AETHER;
+    } catch (e) {
+      return DESIGN_AETHER;
+    }
+  },
+
+  isAether() {
+    return this.getDesign() === DESIGN_AETHER;
+  },
+
+  setDesign(which) {
+    Services.prefs.setStringPref(
+      DESIGN_PREF,
+      which === DESIGN_FIREFOX ? DESIGN_FIREFOX : DESIGN_AETHER
+    );
+  },
+};
