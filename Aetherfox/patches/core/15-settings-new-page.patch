+Preferences.addSetting({
+  id: "aetherScreenDepth",
+  pref: "aether.fingerprinting.screenDepth",
+});
+Preferences.addSetting({
+  id: "aetherTimezone",
+  pref: "aether.fingerprinting.timezoneUTC",
+});
+Preferences.addSetting({
+  id: "aetherDevices",
+  pref: "aether.fingerprinting.mediaDevices",
+});
+Preferences.addSetting({
+  id: "aetherGamepads",
