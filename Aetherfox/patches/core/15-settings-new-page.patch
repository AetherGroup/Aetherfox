+function aetherDevicesHidden(aPrincipal) {
+  try {
+    if (
+      !Services.prefs.getBoolPref("aether.fingerprinting.enabled", true) ||
+      !Services.prefs.getBoolPref("aether.fingerprinting.mediaDevices", false)
