-    bridgedEngine: async () => ({}),
-  });
-  // Stub the inherited real sync so a call is observable (and wouldn't hit the
-  // network); RustPasswordEngine._sync() delegates to it when unlocked.
-  superSync = sandbox.stub(SyncEngine.prototype, "_sync").resolves();
