-  _shouldSubmitForDataChange() {
-    let newID = lazy.fxAccounts.telemetry.getSanitizedUID() || EMPTY_UID;
-    let oldID = this.lastUID;
-    if (
-      newID != EMPTY_UID &&
-      oldID != EMPTY_UID &&
-      // Both are "real" uids, so we care if they've changed.
-      newID != oldID
-    ) {
