+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// API minima siempre en estado "no configurado" para que los llamadores
+// perezosos tomen la rama deshabilitada que ya trae upstream.
+// Ver services/moz.build (solo se empaqueta sin MOZ_SERVICES_SYNC).
+// Sin red, sin estado.
+
+export const STATUS_NOT_CONFIGURED = "not_configured";
+export const STATUS_LOGIN_FAILED = "login_failed";
+export const STATUS_NOT_VERIFIED = "not_verified";
+export const STATUS_SIGNED_IN = "signed_in";
+
+export const ON_UPDATE = "sync-ui-state:update";
+
+const _state = {
+  status: STATUS_NOT_CONFIGURED,
+  email: null,
+  displayName: null,
+  avatarURL: null,
+  uid: null,
+  syncEnabled: false,
+  syncing: false,
+};
+
+export var UIState = {
+  STATUS_NOT_CONFIGURED,
+  STATUS_LOGIN_FAILED,
+  STATUS_NOT_VERIFIED,
+  STATUS_SIGNED_IN,
+  ON_UPDATE,
+  get() {
+    return { ..._state };
+  },
+  isReady() {
+    return true;
+  },
+};
