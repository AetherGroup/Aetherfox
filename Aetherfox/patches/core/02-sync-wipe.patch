-        PanelUI.hide();
-        return;
-      }
-
-      // If we're signed out but have the PXI pref enabled
-      // we should show the PXI panel instead of taking the user
-      // straight to FxA sign-in
-      if (this.FXA_CTA_MENU_ENABLED) {
