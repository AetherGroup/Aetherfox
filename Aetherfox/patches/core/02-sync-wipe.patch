-      return null;
-    }
-    const state = UIState.get();
-    switch (state.status) {
-      case UIState.STATUS_NOT_CONFIGURED:
-      case UIState.STATUS_NOT_VERIFIED:
-        return "signin";
-      case UIState.STATUS_SIGNED_IN: {
-        const engineDisabled = requiredEngines.some(
