-    // nsIObserver is to be an observer
-    QueryInterface: ChromeUtils.generateQI(["nsIObserver"]),
-
-    observe(aSubject, aTopic, aData) {
-      log.debug("observed " + aTopic + " " + aData);
-      if (aTopic == aObserveTopic) {
-        removeMe();
-        aObserveFunc(aSubject, aTopic, aData);
-      }
-    },
-  };
