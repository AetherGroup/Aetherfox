-        count.failed += failedToApply.length;
-        count.applied += backfilledRecordsToApply.length;
-
-        this.toFetch = Utils.setDeleteAll(this.toFetch, ids);
-        this.previousFailedIn = Utils.setAddAll(
-          this.previousFailedIn,
-          failedInBackfill
