-    }
-  },
-
-  get() {
-    return this._doRequest("GET");
-  },
-
-  put(data) {
-    return this._doRequest("PUT", data);
-  },
-
-  post(data) {
-    return this._doRequest("POST", data);
-  },
-
-  delete() {
-    return this._doRequest("DELETE");
-  },
-};
