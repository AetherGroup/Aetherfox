-  );
-  Assert.deepEqual(
-    device.recentDeviceList,
-    [
-      {
-        id: "deviceAAAAAA",
-        name: "iPhone",
-        type: "phone",
-        pushCallback: "http://mochi.test:8888",
-        pushEndpointExpired: false,
-        isCurrentDevice: true,
-      },
-    ],
-    "Should fetch device list"
-  );
-  Assert.equal(
-    spy.getDeviceList.count,
-    1,
-    "Should make request to refresh list"
