-  els.empty.hidden = !!visibleLogs.length;
-  if (!els.empty.hidden) {
-    document.l10n.setAttributes(
-      els.empty,
-      allLogs.length ? "about-sync-log-empty-filtered" : "about-sync-log-empty"
