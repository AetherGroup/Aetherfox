-function urlsafeBase64Encode(buffer) {
-  return ChromeUtils.base64URLEncode(new Uint8Array(buffer), { pad: false });
-}
-
-function urlsafeBase64Decode(str) {
-  return ChromeUtils.base64URLDecode(str, { padding: "reject" });
-}
