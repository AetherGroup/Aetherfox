-  const query = els.search.value.trim().toLowerCase();
-
-  let logs = allLogs;
-
-  if (type !== "all") {
-    logs = logs.filter(log => log.type === type);
-  }
-  if (threshold !== null) {
-    logs = logs.filter(log => log.timestamp >= threshold);
