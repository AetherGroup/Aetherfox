-      const key = scopedKeys[expectedScope];
-      if (
-        !key.hasOwnProperty("scope") ||
-        !key.hasOwnProperty("kid") ||
-        !key.hasOwnProperty("kty") ||
-        !key.hasOwnProperty("k")
