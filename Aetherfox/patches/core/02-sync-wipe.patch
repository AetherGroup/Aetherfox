-}
-
-function dateThreshold(value) {
-  if (value === "all") {
-    return null;
-  }
-  if (value === "today") {
-    const start = new Date();
-    start.setHours(0, 0, 0, 0);
-    return start.getTime();
-  }
-  return Date.now() - Number(value) * 24 * 60 * 60 * 1000;
