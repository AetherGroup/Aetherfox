-    // Add the parent of those records, and ensure its timestamp is the most recent.
-    collection.insert(
-      "toolbar",
-      encryptPayload({
-        id: "toolbar",
-        type: "folder",
-        parentid: "places",
-        title: "Bookmarks Toolbar",
-        children,
-      }),
-      timestamp + 10 * children.length
-    );
