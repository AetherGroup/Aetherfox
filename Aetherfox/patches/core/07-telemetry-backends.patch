-    this.log.config(
-      "enableTelemetryRecording - canRecordBase:" +
-        Services.telemetry.canRecordBase +
-        ", canRecordExtended: " +
-        Services.telemetry.canRecordExtended
-    );
-
-    return Services.telemetry.canRecordBase;
-  },
-});
