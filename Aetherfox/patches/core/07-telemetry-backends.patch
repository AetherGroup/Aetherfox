+// Stable client-ID hash, previously via the removed ClientID.sys.mjs:
+// the same pref and the same sha256 hex digest.
+async function getClientIdHash() {
+  let id = Services.prefs.getStringPref(CLIENTID_PREF, "");
+  if (!UUID_REGEX.test(id)) {
+    id = Services.uuid.generateUUID().toString().slice(1, -1);
