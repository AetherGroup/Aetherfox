-function getPingDirectory() {
-  return (async function () {
-    let directory = TelemetryStorage.pingDirectoryPath;
-
-    if (!(await IOUtils.exists(directory))) {
-      await IOUtils.makeDirectory(directory, { permissions: 0o700 });
-    }
-
-    return directory;
-  })();
