-  // a time, so chunk the result into parts of that size.
-  const chunkSize = 500000;
-  for (let offset = 0; offset < array.length; offset += chunkSize) {
-    buffer += String.fromCharCode.apply(
-      String,
-      array.slice(offset, offset + chunkSize)
-    );
-  }
-  return buffer;
-}
