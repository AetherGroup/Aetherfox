-  RECORD_COUNT_CUMULATIVE(low_memory_events_physical, LowMemoryEventsPhysical);
-#endif
-#if defined(XP_LINUX) && !defined(ANDROID)
-  RECORD_COUNT_CUMULATIVE(page_faults_hard, PageFaultsHard);
-#endif
