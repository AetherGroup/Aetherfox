--- /dev/null
+++ b/browser/installer/windows/nsis/content/launch.js
@@ -0,0 +1,26 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+// Finish page: the install is done, ask whether to launch. Both buttons call
+// back into the installer (external.finishInstall), nothing happens by itself.
+window.attachEvent("onload", function () {
+  // Set direction on the page body.
+  var direction = external.getTextDirection();
+  document.body.style.direction = direction;
+
+  document.getElementById("header").innerText =
+    external.getUIString("finish_heading");
+  document.getElementById("launchButton").innerText =
+    external.getUIString("finish_launch");
+  document.getElementById("closeButton").innerText =
+    external.getUIString("finish_close");
+
+  document.getElementById("launchForm").onsubmit = function () {
+    external.finishInstall("1");
+    return false;
+  };
+  document.getElementById("closeButton").onclick = function () {
+    external.finishInstall("0");
+  };
+});
