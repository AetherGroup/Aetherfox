-        description: >
-          The filename's type, see
-          `nsContentSecurityUtils::FilenameToFilenameType(...)`.
-        type: string
-      contenttype:
-        description: >
-          Information about the content-type we expect to receive
-        type: string
-      remotetype:
-        description: >
-          Information about the remoteType in which we triggered the load
