-                  [&](bool aBool) { return callback(aName, aBool); },
-                  [&](int64_t aInt) { return callback(aName, aInt); },
-                  [&](string_view aStr) { return callback(aName, aStr); },
-                  [&](mozilla::Span<const bool> aBoolSpan) {
