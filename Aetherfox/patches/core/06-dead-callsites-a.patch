+// Aether: minimal peer-request event emitter. Replaces the import
+// from the unpackaged syncedtabs module; same on/off/emit shape.
+class PeerRequestEmitter {
+  constructor() {
+    this._events = new Map();
+  }
+
+  on(event, listener) {
+    if (this._events.has(event)) {
+      this._events.get(event).add(listener);
+    } else {
+      this._events.set(event, new Set([listener]));
+    }
+  }
+
+  off(event, listener) {
+    if (!this._events.has(event)) {
+      return;
+    }
+    this._events.get(event).delete(listener);
+  }
+
+  emit(event, ...args) {
+    if (!this._events.has(event)) {
+      return;
+    }
+    for (let listener of this._events.get(event).values()) {
+      try {
+        listener.apply(this, args);
+      } catch (e) {
+        console.error(e);
+      }
+    }
+  }
+}
+
 export var webrtcUI = {
