# Aether Browser - mozconfig ARTIFACT (fast UI/prefs/branding iteration)
# Usage: $env:MOZCONFIG="$PWD\mozconfig.artifact" ; ./mach build
# Downloads prebuilt binaries from Mozilla CI and only compiles the frontend.
# For the final release use mozconfig.windows (full build).
#
# NOTE: if the custom branding breaks artifact mode, comment out the 3
# branding/app-name lines and retry to validate the rest of the stack.

ac_add_options --enable-project=browser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-aether-artifact
ac_add_options --enable-artifact-builds

# Branding Aether (patch 00). Comentar si artifact mode protesta.
# OJO: `export`, mk_add_options NO llega a configure.
export MOZ_APP_NAME=aether
ac_add_options --with-app-basename=Aether
ac_add_options --with-branding=browser/branding/aether

# Canal propio
ac_add_options --with-update-channel=aether-release

# Build without telemetry or health report (patch 10):
#  - MOZ_TELEMETRY_REPORTING stays OFF (default=mozilla_official, we are unofficial)
#  - MOZ_SERVICES_HEALTHREPORT off (imply=False en browser/moz.configure)
#  - MOZILLA_OFFICIAL indefinido
# Effect: no upload, no Data Collection UI, no Shield Studies.

# No crash reporter in v1 (patch 20): zero crash traffic.
# Only a full build needs the complete toolchain; with artifacts only packaging changes.
ac_add_options --disable-crashreporter
