Aether: clear the page cache from the shields panel

New option in the Aetherfox Shields panel: "Clear page cache". It drops
the pages the browser kept on disk and in memory with the same sanitiser
the "Clear browsing data" dialog uses, and the panel says it happened and
offers the reload that makes the page pick up the fresh copy.

From scratch, in the panel that already holds the protection switches:

  - aetherProtectionsPanel.inc.xhtml: the new row and the row that
    reports it.
  - browser-aetherProtections.js: the handler (Sanitizer.sanitize) and the
    wiring.
  - aetherProtections.ftl: the strings.
  - panel.css / jar.inc.mn: the new icon (aether-cache.svg).
diff --git a/browser/base/content/browser-aetherProtections.js b/browser/base/content/browser-aetherProtections.js
index bcd7a1533394c5122a8acf03c93471d6528e7565..056ce4e645be1718e813bba210b746bb7a4e2b43 100644
--- a/browser/base/content/browser-aetherProtections.js
+++ b/browser/base/content/browser-aetherProtections.js
@@ -13,6 +13,12 @@
  * this site only (exact base domain), then also offers the reload.
  */
 
+// The page cache is cleared with the same sanitiser the "Clear browsing
+// data" dialog uses, so the disk and the memory cache go away in one go.
+const { Sanitizer } = ChromeUtils.importESModule(
+  "resource:///modules/Sanitizer.sys.mjs"
+);
+
 var gAetherProtections = {
   // Slim panel: only the master pref lives here. Layer toggles live in
   // about:aethersettings and the stock popups (their own controllers).
@@ -52,6 +58,12 @@ var gAetherProtections = {
       "click",
       () => this._onReload()
     );
+    this.$("#aether-protections-clear-cache").addEventListener("click", () =>
+      this._onClearCache()
+    );
+    this.$("#aether-protections-cache-reload").addEventListener("click", () =>
+      this._onReload()
+    );
     window.addEventListener("unload", () => this._uninit(), { once: true });
     this._inited = true;
   },
@@ -69,6 +81,7 @@ var gAetherProtections = {
     this._ensureInit();
     this.render();
     this.$("#aether-protections-reload-row").hidden = true;
+    this.$("#aether-protections-cache-row").hidden = true;
     let anchor = document.getElementById(
       "tracking-protection-icon-container"
     );
@@ -152,6 +165,23 @@ var gAetherProtections = {
     this.$("#aether-protections-reload-row").hidden = false;
   },
 
+  // Clear the page cache: every page the browser kept on disk (and in
+  // memory) is dropped, so the next visit fetches it from the network
+  // again. The user asked for it, so it happens once and the panel says
+  // so, with the reload that makes the page pick up the fresh copy.
+  async _onClearCache() {
+    const button = this.$("#aether-protections-clear-cache");
+    const row = this.$("#aether-protections-cache-row");
+    button.disabled = true;
+    try {
+      await Sanitizer.sanitize(["cache"]);
+    } catch (e) {
+      console.error("AetherProtections: clearing the page cache failed", e);
+    }
+    button.disabled = false;
+    row.hidden = false;
+  },
+
   _onReload() {
     this.panel.hidePopup();
     gBrowser.reload();
