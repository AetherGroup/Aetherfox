 // file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-window.attachEvent("onload", function () {
+window.addEventListener("load", function () {
   if (parseInt(external.getIsHighContrast())) {
     document.body.className += " high-contrast";
   }
 
-  document.body.style.fontFamily = external.getFontName() + ", sans-serif";
+  document.body.style.fontFamily = '"Quicksand", "' + external.getFontName() + '", sans-serif';
 
   // Disallow dragging of the "background" image.
-  document.getElementById("background").attachEvent("ondragstart", function () {
+  document.getElementById("background").addEventListener("dragstart", function (e) {
+    e.preventDefault();
     return false;
   });
 });
diff --git a/browser/installer/windows/nsis/content/welcome.html b/browser/installer/windows/nsis/content/welcome.html
new file mode 100644
index 0000000000000000000000000000000000000000..37ac9755a0dbe30c7d2444c7dc0fc574f5819201
--- /dev/null
+++ b/browser/installer/windows/nsis/content/welcome.html
@@ -0,0 +1,34 @@
+<!doctype html>
+
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+
+<html>
+  <head>
+    <meta charset="UTF-8" />
+    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
+
+    <link rel="stylesheet" href="stub_common.css" />
+    <link rel="stylesheet" href="welcome_page.css" />
+
+    <script src="stub_common.js"></script>
+    <script src="welcome.js"></script>
+  </head>
+  <body>
+    <img id="background" src="bgstub.jpg" alt="" role="presentation" />
+
+    <div id="splash"><span id="splashText"></span></div>
+
+    <form id="welcomeForm" style="visibility: hidden;">
+      <h1 id="header"></h1>
+
+      <div id="startButtonContainer">
+        <button type="submit" id="startButton"></button>
+      </div>
+      <div id="cancelButtonContainer">
+        <button type="button" id="cancelButton"></button>
+      </div>
+    </form>
+  </body>
+</html>
diff --git a/browser/installer/windows/nsis/content/welcome.js b/browser/installer/windows/nsis/content/welcome.js
new file mode 100644
index 0000000000000000000000000000000000000000..65cf099bedf51d5d6c315401e7645b39099f7123
--- /dev/null
+++ b/browser/installer/windows/nsis/content/welcome.js
@@ -0,0 +1,73 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+// Welcome gate with a splash first: big "Welcome" fades in, holds, fades
+// out, then the heading + buttons appear. Both buttons call back into the
+// installer (external.chooseWelcome), nothing happens by itself.
+// No CSS transitions: plain opacity driven by timers. Timings at the
+// top for tuning.
+var WELCOME_FADE_MS = 600;
+var WELCOME_HOLD_MS = 800;
+var WELCOME_STEP_MS = 30;
+
+function welcomeSetOpacity(el, v) {
+  el.style.opacity = v / 100;
+}
+
+function welcomeFade(el, from, to, ms, done) {
+  var steps = Math.max(1, Math.round(ms / WELCOME_STEP_MS));
+  var i = 0;
+  function tick() {
+    i++;
+    var v = from + Math.round(((to - from) * i) / steps);
+    welcomeSetOpacity(el, v);
+    if (i < steps) {
+      window.setTimeout(tick, WELCOME_STEP_MS);
+    } else if (done) {
+      done();
+    }
+  }
+  tick();
+}
+
+window.addEventListener("load", function () {
+  // Set direction on the page body.
+  var direction = external.getTextDirection();
+  document.body.style.direction = direction;
+
+  document.getElementById("splashText").innerText =
+    external.getUIString("welcome_splash");
+
+  var splash = document.getElementById("splash");
+  var form = document.getElementById("welcomeForm");
+
+  function showForm() {
+    splash.style.display = "none";
+    welcomeSetOpacity(form, 0);
+    form.style.visibility = "visible";
+    welcomeFade(form, 0, 100, WELCOME_FADE_MS, null);
+
+    document.getElementById("header").innerText =
+      external.getUIString("welcome_heading");
+    document.getElementById("startButton").innerText =
+      external.getUIString("welcome_start");
+    document.getElementById("cancelButton").innerText =
+      external.getUIString("welcome_cancel");
+
+    document.getElementById("welcomeForm").onsubmit = function () {
+      external.chooseWelcome("1");
+      return false;
+    };
+    document.getElementById("cancelButton").onclick = function () {
+      external.chooseWelcome("0");
+    };
+  }
+
+  welcomeSetOpacity(splash, 0);
+  welcomeFade(splash, 0, 100, WELCOME_FADE_MS, function () {
+    window.setTimeout(function () {
+      welcomeFade(splash, 100, 0, WELCOME_FADE_MS, showForm);
+    }, WELCOME_HOLD_MS);
+  });
+});
