+  nsis/content/comfortaa-bold.woff \
+  nsis/content/comfortaa-medium.woff \
+  nsis/content/quicksand-bold.woff \
   nsis/installer.nsi \
   nsis/install_dir_helpers.nsh \
   nsis/installer_helpers.nsh \
