diff --git a/browser/installer/windows/nsis/content/stub_common.js b/browser/installer/windows/nsis/content/stub_common.js
index 7c51bc5686e7313744589687cb45299e119a56ce..5a32787df5e765f5dfc6334f4ecbdeab40f67ecf 100644
--- a/browser/installer/windows/nsis/content/stub_common.js
