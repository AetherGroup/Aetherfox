+/* Aether brand fonts (IE Edge mode reads WOFF). Segoe UI stays as the
+ * fallback if a file is missing. Titles use Quicksand Bold; body text and
+ * buttons use Comfortaa. */
+@font-face {
+  font-family: "Quicksand";
+  src: url("quicksand-bold.woff") format("woff");
+  font-weight: 700;
+}
+@font-face {
+  font-family: "Comfortaa";
+  src: url("comfortaa-medium.woff") format("woff");
+  font-weight: 500;
+}
+@font-face {
+  font-family: "Comfortaa";
+  src: url("comfortaa-bold.woff") format("woff");
+  font-weight: 700;
+}
+
 body {
+  font-weight: 500;
   height: 100%;
   width: 100%;
   margin: 0;
   padding: 0;
   overflow: hidden;
 
-  font-family: "Segoe UI", sans-serif;
+  font-family: "Comfortaa", "Segoe UI", sans-serif;
+  font-weight: 500;
 }
 
