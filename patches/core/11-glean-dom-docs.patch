-JSObject* Glean::WrapObject(JSContext* aCx, JS::Handle<JSObject*> aGivenProto) {
-  return dom::GleanImpl_Binding::Wrap(aCx, this, aGivenProto);
-}
-
-Glean::Glean(nsIGlobalObject* aGlobal) : mParent(aGlobal) {}
