+.aether-toggle::part(button) { border: 0; border-radius: 20px; }
+.aether-toggle[pressed]::part(button) { background-image: linear-gradient(135deg, var(--aether-accent), var(--aether-accent2)); }
+.aether-toggle:focus-visible::part(button) { outline: 2px solid var(--aether-accent); outline-offset: 2px; }
+
+/* Expander chevron. */
+.aether-chev { appearance: none; border: 0; width: 28px; height: 28px; border-radius: 8px; background: var(--aether-tile); flex: none;
+  background-image: url("chrome://browser/skin/controlcenter/aether-chev.svg"); background-repeat: no-repeat; background-position: center; background-size: 18px;
+  -moz-context-properties: stroke; stroke: var(--aether-strong); transition: transform .15s; }
