+  --toggle-background-color-pressed: var(--aether-accent);
+  --toggle-background-color-pressed-hover: var(--aether-accent);
+  --toggle-background-color-pressed-active: var(--aether-accent);
+  --toggle-dot-background-color: #FFFFFF;
