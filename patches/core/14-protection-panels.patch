+// Extra listed hosts for gates (comma-separated, e.g. "localhost").
+let extraHosts = new Set();
+
+function refreshExtraHosts() {
+  try {
+    extraHosts = new Set(
+      Services.prefs
+        .getStringPref(PREF_EXTRA_HOSTS, "")
+        .split(",")
+        .map(s => s.trim().toLowerCase())
+        .filter(s => s.length > 0)
+    );
+  } catch (e) {
+    extraHosts = new Set();
+  }
+}
+
+function baseDomainOf(host) {
+  try {
+    return Services.eTLD.getBaseDomainFromHost(host);
+  } catch (e) {
+    return null;
+  }
+}
+
+// Exact host or any parent suffix ("a.b.example.com" matches "example.com").
+function isListed(host) {
+  let current = host;
+  for (;;) {
+    if (LISTED_HOSTS.has(current) || extraHosts.has(current)) {
+      return true;
+    }
+    const dot = current.indexOf(".");
+    if (dot < 0) {
+      return false;
+    }
+    current = current.slice(dot + 1);
+  }
+}
+
+export const AetherFingerprinterBlock = {
+  QueryInterface: ChromeUtils.generateQI(["nsIObserver"]),
+
+  init() {
+    refreshExtraHosts();
+    Services.prefs.addObserver(PREF_ENABLED, this);
+    Services.prefs.addObserver(PREF_EXTRA_HOSTS, this);
+    Services.obs.addObserver(this, TOPIC_REQUEST);
+    Services.obs.addObserver(this, TOPIC_PROFILE_END);
+  },
+
+  uninit() {
+    try {
+      Services.obs.removeObserver(this, TOPIC_REQUEST);
+    } catch (e) {}
+    try {
+      Services.obs.removeObserver(this, TOPIC_PROFILE_END);
+    } catch (e) {}
+  },
+
+  observe(subject, topic) {
+    if (topic === TOPIC_PROFILE_END) {
+      this.uninit();
+      return;
+    }
+    if (topic === PREF_ENABLED || topic === PREF_EXTRA_HOSTS) {
+      refreshExtraHosts();
+      return;
+    }
+    if (topic !== TOPIC_REQUEST) {
+      return;
+    }
+    let enabled = true;
+    try {
+      enabled = Services.prefs.getBoolPref(PREF_ENABLED, true);
+    } catch (e) {}
+    if (!enabled) {
+      return;
+    }
+    let channel;
+    try {
+      channel = subject.QueryInterface(Ci.nsIHttpChannel);
+    } catch (e) {
+      return;
+    }
+    let scheme = "";
+    try {
+      scheme = channel.URI.scheme;
+    } catch (e) {
+      return;
+    }
+    if (scheme !== "http" && scheme !== "https") {
+      return;
+    }
+    let host = "";
+    try {
+      host = channel.URI.asciiHost.toLowerCase();
+    } catch (e) {
+      return;
+    }
+    if (!isListed(host)) {
+      return;
+    }
+    // Third-party only; fail open when the relationship is undeterminable.
+    let firstHost = "";
+    try {
+      const loading = channel.loadInfo && channel.loadInfo.loadingPrincipal;
+      if (!loading) {
+        return;
+      }
+      firstHost = loading.asciiHost.toLowerCase();
+      if (!firstHost) {
+        return;
+      }
+    } catch (e) {
+      return;
+    }
+    const requestBase = baseDomainOf(host) || host;
+    const firstBase = baseDomainOf(firstHost) || firstHost;
+    if (requestBase === firstBase) {
+      return;
+    }
+    try {
+      channel.cancel(Cr.NS_BINDING_ABORTED);
+    } catch (e) {}
+  },
+};
