+  background: var(--aether-well); border: 1px solid var(--aether-line);
+  border-radius: 10px; padding: 8px 10px; }
+.aether-reload[hidden] { display: none; }
+.aether-reload .aether-d { flex: 1; }
+.aether-go { appearance: none; border: 0; border-radius: 8px; padding: 6px 14px;
+  background-image: linear-gradient(135deg, var(--aether-accent), var(--aether-accent2));
+  color: #FFFFFF; font-weight: 700; cursor: pointer; }
+.aether-go:hover { filter: brightness(1.08); }
+@media (prefers-reduced-motion: reduce) { .aether-chev { transition: none; } }
