diff --git a/browser/base/content/browser-aetherProtections.js b/browser/base/content/browser-aetherProtections.js
new file mode 100644
index 0000000000000000000000000000000000000000..bcd7a1533394c5122a8acf03c93471d6528e7565
--- /dev/null
+++ b/browser/base/content/browser-aetherProtections.js
@@ -0,0 +1,208 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * gAetherProtections: controller for the Aether shields panel.
+ *
+ * Opened from the shield and trust buttons instead of the Firefox popups.
+ * Slim panel: master switch, per-site exemption and a link to the full
+ * fingerprint settings (layer toggles live in about:aethersettings and
+ * the stock popups). Changing anything marks the panel dirty and offers
+ * a page reload (engine state is per load). The broken-site button exempts
+ * this site only (exact base domain), then also offers the reload.
+ */
+
+var gAetherProtections = {
+  // Slim panel: only the master pref lives here. Layer toggles live in
+  // about:aethersettings and the stock popups (their own controllers).
+  PREFS: {
+    enabled: "aether.fingerprinting.enabled",
+  },
+  KEYS: ["enabled"],
+
+  _inited: false,
+
+  get panel() {
+    return document.getElementById("aether-protections-popup");
+  },
+
+  $(sel) {
+    return this.panel.querySelector(sel);
+  },
+
+  _ensureInit() {
+    if (this._inited) {
+      return;
+    }
+    this._observer = () => this.render();
+    for (const key of this.KEYS) {
+      Services.prefs.addObserver(this.PREFS[key], this._observer);
+    }
+    this.panel.addEventListener("toggle", event => this._onToggle(event));
+    this.panel.addEventListener("popupshowing", () => this.render());
+    this.panel.addEventListener("popuphidden", () => this.onPopupHidden());
+    this.$("#aether-protections-site").addEventListener("click", () =>
+      this._onBrokenSite()
+    );
+    this.$("#aether-protections-settings").addEventListener("click", () =>
+      this._onSettingsLink()
+    );
+    this.$("#aether-protections-reload-button").addEventListener(
+      "click",
+      () => this._onReload()
+    );
+    window.addEventListener("unload", () => this._uninit(), { once: true });
+    this._inited = true;
+  },
+
+  _uninit() {
+    for (const key of this.KEYS) {
+      try {
+        Services.prefs.removeObserver(this.PREFS[key], this._observer);
+      } catch (e) {}
+    }
+  },
+
+  // Called from the shield/trust button handlers with the click event.
+  open(event) {
+    this._ensureInit();
+    this.render();
+    this.$("#aether-protections-reload-row").hidden = true;
+    let anchor = document.getElementById(
+      "tracking-protection-icon-container"
+    );
+    if (!anchor || anchor.clientWidth == 0) {
+      anchor = document.getElementById("trust-icon-container");
+    }
+    if (!anchor || anchor.clientWidth == 0) {
+      anchor = document.getElementById("identity-icon-box");
+    }
+    if (!anchor || anchor.clientWidth == 0) {
+      anchor = null;
+    }
+    PanelMultiView.openPopup(this.panel, anchor || gBrowser.selectedBrowser, {
+      position: "bottomcenter topleft",
+      triggerEvent: event,
+    }).catch(console.error);
+  },
+
+  onPopupShowing() {
+    this.render();
+  },
+
+  onPopupHidden() {},
+
+  _currentBaseDomain() {
+    try {
+      const uri = gBrowser.currentURI;
+      if (!uri || (uri.scheme !== "http" && uri.scheme !== "https")) {
+        return null;
+      }
+      // IP literals and single-label hosts have no eTLD+1: show the host
+      // itself instead of an empty string (exemptions stay exact-host).
+      try {
+        return Services.eTLD.getBaseDomainFromHost(uri.host);
+      } catch (e) {
+        return uri.host || null;
+      }
+    } catch (e) {
+      return null;
+    }
+  },
+
+  _isSiteExempt(domain) {
+    if (!domain) {
+      return false;
+    }
+    return Services.prefs.getBoolPref(
+      "aether.fingerprinting.exempt.all." + domain,
+      false
+    );
+  },
+
+  _getPref(key) {
+    return Services.prefs.getBoolPref(this.PREFS[key], true);
+  },
+
+  _onToggle(event) {
+    const target = event.target.closest
+      ? event.target.closest("moz-toggle")
+      : null;
+    if (!target || !target.dataset.key) {
+      return;
+    }
+    Services.prefs.setBoolPref(
+      this.PREFS[target.dataset.key],
+      !!target.pressed
+    );
+    this.render();
+    this.$("#aether-protections-reload-row").hidden = false;
+  },
+
+  _onBrokenSite() {
+    const domain = this._currentBaseDomain();
+    if (!domain) {
+      return;
+    }
+    const pref = "aether.fingerprinting.exempt.all." + domain;
+    const exempt = Services.prefs.getBoolPref(pref, false);
+    Services.prefs.setBoolPref(pref, !exempt);
+    this.render();
+    this.$("#aether-protections-reload-row").hidden = false;
+  },
+
+  _onReload() {
+    this.panel.hidePopup();
+    gBrowser.reload();
+  },
+
+  _onSettingsLink() {
+    this.panel.hidePopup();
+    window.openTrustedLinkIn("about:aethersettings#shield", "tab");
+  },
+
+  render() {
+    const master = this._getPref("enabled");
+    for (const toggle of this.panel.querySelectorAll(
+      "moz-toggle[data-key]"
+    )) {
+      const key = toggle.dataset.key;
+      const on = this._getPref(key);
+      toggle.pressed = on;
+      toggle.disabled = key !== "enabled" && !master;
+      const state = this.panel.querySelector(
+        `[data-state-for="${key}"]`
+      );
+      if (state) {
+        state.dataset.on = String(on);
+        document.l10n.setAttributes(
+          state,
+          on ? "aether-protections-state-on" : "aether-protections-state-off"
+        );
+      }
+    }
+    const domain = this._currentBaseDomain();
+    const host = domain || "";
+    try {
+      document.l10n.setAttributes(
+        this.$("#aether-protections-host"),
+        "aether-protections-host",
+        { host }
+      );
+    } catch (e) {}
+    const exempt = this._isSiteExempt(domain);
+    this.$("#aether-protections-mainView").dataset.siteExempt =
+      String(exempt);
+    const id = exempt ? "fixed" : "broken";
+    document.l10n.setAttributes(
+      this.$("#aether-protections-site-title"),
+      `aether-protections-site-${id}-title`
+    );
+    document.l10n.setAttributes(
+      this.$("#aether-protections-site-desc"),
+      `aether-protections-site-${id}-desc`
+    );
+    this.$("#aether-protections-site").disabled = domain === null;
+  },
+};
