diff --git a/browser/components/controlcenter/content/aetherProtectionsPanel.inc.xhtml b/browser/components/controlcenter/content/aetherProtectionsPanel.inc.xhtml
new file mode 100644
index 0000000000000000000000000000000000000000..ab9409016a221f497b8211974957125dbcef5aad
--- /dev/null
+++ b/browser/components/controlcenter/content/aetherProtectionsPanel.inc.xhtml
@@ -0,0 +1,63 @@
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this file,
+   - You can obtain one at http://mozilla.org/MPL/2.0/. -->
+
+<!-- Aether shields panel: slim entry point. Opened from the shield and
+     trust buttons instead of the Firefox popups. Master switch, per-site
+     exemption and a link to the full fingerprint settings; the layer
+     toggles live in about:aethersettings and the stock popups. -->
+
+<panel id="aether-protections-popup"
+       class="panel-no-padding"
+       type="arrow"
+       role="alertdialog"
+       noautofocus="true"
+       aria-labelledby="aether-protections-title"
+       orient="vertical">
+  <panelmultiview id="aether-protections-multiView"
+                  mainViewId="aether-protections-mainView">
