diff --git a/browser/themes/shared/controlcenter/panel.css b/browser/themes/shared/controlcenter/panel.css
index 7a5d6a777c54e1164640d64345b61ce988515267..500940822c7806ff4aa01181a49146b6605e138f 100644
--- a/browser/themes/shared/controlcenter/panel.css
+++ b/browser/themes/shared/controlcenter/panel.css
@@ -1180,3 +1180,112 @@
     background-position-x: left var(--space-large);
   }
 }
+
+/* ===== Aether shields panel (aether-* block) =====
+   Light/dark tokens with light-dark(). "Softly rounded square" system:
+   rows 8, main block 10, panel 10. Shadow kept inside its margin room
+   (offset+blur-spread <= margin) so the window edge never slices it square. */
+#aether-protections-popup {
+  color-scheme: light dark;
+  --aether-bg:      light-dark(#FFFFFF, #241E50);
+  --aether-well:    light-dark(#F7F6FC, #1B1640);
+  --aether-tile:    light-dark(#EAE6F9, #2E2766);
+  --aether-hover:   light-dark(#E2DEF5, rgba(155,140,255,.24));
+  --aether-line:    light-dark(rgba(108,92,231,.18), rgba(155,140,255,.2));
+  --aether-edge:    light-dark(#CFC7F2, rgba(155,140,255,.3));
+  --aether-ink:     light-dark(#2A2257, #E2DEF5);
+  --aether-strong:  light-dark(#3B2F8F, #FFFFFF);
+  --aether-muted:   light-dark(#5C5780, #A9A2D6);
+  --aether-accent:  light-dark(#6C5CE7, #9B8CFF);
+  --aether-accent2: light-dark(#B9AEEF, #6C5CE7);
+  --aether-off:     light-dark(#C9C0F0, #4A4290);
+  --panel-background-color: var(--aether-bg);
+  --panel-text-color: var(--aether-ink);
+  --panel-border-color: var(--aether-edge);
+  --panel-border-radius: 10px;
+  --panel-box-shadow: 0 6px 14px -8px light-dark(rgba(59,47,143,.40), rgba(0,0,0,.60));
+  --panel-box-shadow-margin: 12px;
+  --panel-padding: 0;
+  --panel-width: 356px;
+  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
+}
+.aether-view { display: flex; flex-direction: column; width: 340px; padding: 8px; gap: 4px; color: var(--aether-ink); }
+.aether-head { display: flex; align-items: center; gap: 10px; padding: 6px 6px 8px; }
+.aether-head-t { display: flex; flex-direction: column; min-width: 0; }
+.aether-title { font-size: 15px; font-weight: 700; color: var(--aether-strong); }
+.aether-host  { font-size: 11.5px; color: var(--aether-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+/* Thin-stroke icons: ink stroke, brand-gradient accent. */
+.aether-ic {
+  flex: none; width: 30px; height: 30px; border-radius: 8px; background-color: var(--aether-tile);
+  background-repeat: no-repeat; background-position: center; background-size: 18px;
+  -moz-context-properties: fill, stroke; fill: var(--aether-accent); stroke: var(--aether-strong);
+}
+.aether-ic[data-icon="shield"] { background-image: url("chrome://browser/skin/controlcenter/aether-shield.svg"); }
+.aether-ic[data-icon="canvas"] { background-image: url("chrome://browser/skin/controlcenter/aether-canvas.svg"); }
+.aether-ic[data-icon="text"] { background-image: url("chrome://browser/skin/controlcenter/aether-text.svg"); }
+.aether-ic[data-icon="webgl"] { background-image: url("chrome://browser/skin/controlcenter/aether-webgl.svg"); }
+.aether-ic[data-icon="audio"] { background-image: url("chrome://browser/skin/controlcenter/aether-audio.svg"); }
+.aether-ic[data-icon="cpu"] { background-image: url("chrome://browser/skin/controlcenter/aether-cpu.svg"); }
+.aether-ic[data-icon="pause"] { background-image: url("chrome://browser/skin/controlcenter/aether-pause.svg"); }
+
+.aether-row { display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 8px; }
+.aether-row:hover { background: var(--aether-hover); }
+.aether-main { background: var(--aether-well); padding: 9px 10px; border-radius: 10px; }
+.aether-txt { flex: 1; min-width: 0; display: flex; flex-direction: column; }
+.aether-t { font-size: 13px; font-weight: 600; color: var(--aether-strong); }
+.aether-d { font-size: 11.5px; line-height: 1.35; color: var(--aether-muted); }
+.aether-sw { display: flex; flex-direction: column; align-items: center; gap: 2px; flex: none; }
+.aether-state { font-size: 10.5px; font-weight: 700; color: var(--aether-accent); }
+.aether-state[data-on="false"] { color: var(--aether-muted); }
+
+/* Toggle switch (html:moz-toggle). */
+.aether-toggle {
+  --toggle-width: 36px; --toggle-height: 20px;
+  --toggle-dot-height: 14px; --toggle-dot-width: 14px; --toggle-dot-margin: 3px;
