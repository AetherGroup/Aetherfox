+++ b/dom/canvas/AetherCanvasNoise.h
@@ -0,0 +1,88 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef mozilla_dom_AetherCanvasNoise_h
+#define mozilla_dom_AetherCanvasNoise_h
+
+#include <stdint.h>
+
+class nsIPrincipal;
+
+namespace mozilla::dom {
+
+// Aether graded anti-fingerprinting, layer B (canvas 2D reads).
+//
+// Deterministic per (browser launch, first-party base domain) noise applied
+// at read time only. The same site in the same session always reads back
+// identical pixels; a different site reads different pixels; a relaunch
+// reseeds everything. Only the blue LSB of pixel 0 plus ~1/256 of the
+// remaining pixels is touched, so rendering is perceptually unchanged.
+//
+// Split into two calls because SpiderMonkey forbids service calls inside
+// AutoCheckCannotGC regions: KeyForPrincipal() may touch services (random
+// generator, hash, prefs) and must run outside them; ApplyNoise() is pure
+// integer math and is safe to run on a live typed-array pointer.
+namespace AetherCanvasNoise {
+
+// True when noise applies to this read, with aDomainKey filled (32 bytes).
+// False (fail open, caller returns raw pixels) when the kill pref is off,
+// the principal has no base domain, or the session secret cannot be made.
+bool KeyForPrincipal(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]);
+
+// Same contract as KeyForPrincipal, gated by the WebGL kill pref instead of
+// the canvas one. Shares the session secret and the key schedule.
+bool KeyForWebGL(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]);
+
+// Same contract as KeyForPrincipal, gated by the audio kill pref. Used for
+// AnalyserNode readouts (caller-owned arrays only).
+bool KeyForAudio(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]);
+
+// Same contract as KeyForPrincipal, gated by the text-metrics kill pref.
+// Used for canvas measureText widths.
+bool KeyForText(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]);
+
+// Deterministic pick in [0, aCount) from a domain key. Pure integer math,
+// safe anywhere (used to choose coherent spoofed renderer/vendor pairs).
+uint64_t SelectIndex(const uint8_t aDomainKey[32], uint64_t aCount);
+
+// True when this base domain is exempted for aSurface (or for all
+// surfaces): backend for the per-site broken-site switch. Dynamic pref
+// names need no defaults; absent means protected. Thread-safe.
+bool SiteExempted(nsIPrincipal* aPrincipal, const char* aSurface);
+
+// One SplitMix64 step over an explicit state. Lets callers draw several
+// uncorrelated values from a single domain key (family, model, PCI ID)
+// without any service calls.
+uint64_t MixOnce(uint64_t* aState);
+
+// Flip the blue LSB of pixel 0 and of the ~1/256 pixels selected by
+// SplitMix64(domainKey, index). aPixels is a packed width*height buffer
+// with 4 bytes per pixel; aBlueOffset is the blue byte within a pixel
+// (2 for RGBA readback, 0 for packed BGRA encode buffers).
+void ApplyNoise(uint8_t* aPixels, uint32_t aWidth, uint32_t aHeight,
+                const uint8_t aDomainKey[32], uint32_t aBlueOffset = 2);
