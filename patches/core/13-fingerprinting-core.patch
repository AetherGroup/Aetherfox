diff --git a/dom/canvas/AetherCanvasNoise.cpp b/dom/canvas/AetherCanvasNoise.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..40e410caf0bb7a5555bbb5f41a9ac28b0e272bd5
--- /dev/null
+++ b/dom/canvas/AetherCanvasNoise.cpp
@@ -0,0 +1,243 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this file,
+ * You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "mozilla/dom/AetherCanvasNoise.h"
+
+#include "mozilla/Preferences.h"
+#include "nsCOMPtr.h"
+#include "nsICryptoHash.h"
+#include "nsIPrincipal.h"
+#include "nsIRandomGenerator.h"
+#include "nsServiceManagerUtils.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace mozilla::dom::AetherCanvasNoise {
+
+namespace {
+
+// Launches with the process: raw material for every per-site domain key.
+// Memory only, never persisted, never sent anywhere.
+std::once_flag gSecretOnce;
+uint8_t gSecret[32];
+bool gSecretReady = false;
+
+void InitSecret() {
+  nsresult rv;
+  nsCOMPtr<nsIRandomGenerator> rg =
+      do_GetService("@mozilla.org/security/random-generator;1", &rv);
+  if (NS_FAILED(rv)) {
+    return;
+  }
+  uint8_t* raw = nullptr;
+  rv = rg->GenerateRandomBytes(sizeof(gSecret), &raw);
+  if (NS_FAILED(rv) || !raw) {
+    return;
+  }
+  memcpy(gSecret, raw, sizeof(gSecret));
+  free(raw);
+  gSecretReady = true;
+}
+
+// SplitMix64 (Steele, Lea, Flood 2014): tiny, dependency-free, good enough
+// to turn a keyed seed into an uncorrelated per-pixel decision bit.
+uint64_t SplitMix64(uint64_t& aState) {
+  uint64_t z = (aState += 0x9E3779B97F4A7C15ull);
+  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+  z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+  return z ^ (z >> 31);
+}
+
+uint64_t LoadU64LE(const uint8_t* aBytes) {
+  uint64_t v = 0;
+  for (int i = 7; i >= 0; --i) {
+    v = (v << 8) | aBytes[i];
+  }
+  return v;
+}
+
+}  // namespace
+
+bool SiteExempted(nsIPrincipal* aPrincipal, const char* aSurface) {
+  if (!aPrincipal || !aSurface) {
+    return false;
+  }
+  nsAutoCString baseDomain;
+  if (NS_FAILED(aPrincipal->GetBaseDomain(baseDomain)) ||
+      baseDomain.IsEmpty()) {
+    return false;
+  }
+  nsAutoCString exemptAll("aether.fingerprinting.exempt.all.");
+  exemptAll.Append(baseDomain);
+  if (Preferences::GetBool(exemptAll.get(), false)) {
+    return true;
+  }
+  nsAutoCString exemptSurface("aether.fingerprinting.exempt.");
+  exemptSurface.Append(aSurface);
+  exemptSurface.Append('.');
+  exemptSurface.Append(baseDomain);
+  return Preferences::GetBool(exemptSurface.get(), false);
+}
+
+bool KeyForPref(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32],
+                const char* aPrefName, const char* aSurface) {
+  // Master switch first: one pref gates the whole graded system. The
+  // per-surface kill prefs below only refine it (the end-state UI binds
+  // this master plus one toggle per surface).
+  if (!Preferences::GetBool("aether.fingerprinting.enabled", true)) {
+    return false;
+  }
+  if (!Preferences::GetBool(aPrefName, true)) {
+    return false;
+  }
+  if (!aPrincipal) {
+    return false;
+  }
+  std::call_once(gSecretOnce, InitSecret);
+  if (!gSecretReady) {
+    return false;
+  }
+  nsAutoCString baseDomain;
+  nsresult rvBD = aPrincipal->GetBaseDomain(baseDomain);
+  if (NS_FAILED(rvBD) || baseDomain.IsEmpty()) {
+    return false;
+  }
+
+  if (SiteExempted(aPrincipal, aSurface)) {
+    return false;
+  }
+
+  nsCOMPtr<nsICryptoHash> hash;
+  // NS_NewCryptoHash already initializes the object; calling Init again
+  // fails (NS_ERROR_FAILURE), so go straight to Update.
+  nsresult rv = NS_NewCryptoHash(nsICryptoHash::SHA256, getter_AddRefs(hash));
+  if (NS_FAILED(rv) || !hash) {
+    return false;
+  }
+  // Domain separation byte between secret and context: SHA256 here only
+  // stretches the secret into per-site keys, it authenticates nothing, so
+  // length-extension properties of the hash do not matter.
+  rv = hash->Update(gSecret, sizeof(gSecret));
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+  const uint8_t sep = 0x00;
+  rv = hash->Update(&sep, 1);
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+  rv = hash->Update(
+      reinterpret_cast<const uint8_t*>(baseDomain.BeginReading()),
+      baseDomain.Length());
+  if (NS_FAILED(rv)) {
+    return false;
+  }
+  nsAutoCString digest;
+  rv = hash->Finish(false, digest);
+  if (NS_FAILED(rv) || digest.Length() != 32) {
+    return false;
+  }
+  memcpy(aDomainKey, digest.get(), 32);
+  return true;
+}
+
+bool KeyForPrincipal(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]) {
+  return KeyForPref(aPrincipal, aDomainKey,
+                    "aether.fingerprinting.canvasNoise2d", "canvas2d");
+}
+
+bool KeyForWebGL(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]) {
+  return KeyForPref(aPrincipal, aDomainKey, "aether.fingerprinting.webglNoise",
+                    "webgl");
+}
+
+bool KeyForAudio(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]) {
+  return KeyForPref(aPrincipal, aDomainKey, "aether.fingerprinting.audioNoise",
+                    "audio");
+}
+
+bool KeyForText(nsIPrincipal* aPrincipal, uint8_t aDomainKey[32]) {
+  return KeyForPref(aPrincipal, aDomainKey, "aether.fingerprinting.textMetrics",
+                    "text");
+}
+
+uint64_t FNV1a(const char16_t* aData, uint32_t aLength) {
+  uint64_t hash = 0xCBF29CE484222325ull;
+  for (uint32_t i = 0; i < aLength; ++i) {
+    hash ^= static_cast<uint64_t>(aData[i]);
+    hash *= 0x100000001B3ull;
+  }
+  return hash;
+}
+
+double NudgeDouble(double aValue, const uint8_t aDomainKey[32],
+                   uint64_t aContext) {
+  uint64_t state =
+      LoadU64LE(aDomainKey) ^ aContext ^ 0x94D049BB133111EBull;
+  uint64_t bits;
+  memcpy(&bits, &aValue, sizeof(bits));
+  if (SplitMix64(state) & 1u) {
+    ++bits;
+  } else {
+    --bits;
+  }
+  double out;
+  memcpy(&out, &bits, sizeof(out));
+  return out;
+}
+
+uint64_t SelectIndex(const uint8_t aDomainKey[32], uint64_t aCount) {
+  if (!aCount) {
+    return 0;
+  }
+  uint64_t state = LoadU64LE(aDomainKey);
+  return SplitMix64(state) % aCount;
+}
+
+uint64_t MixOnce(uint64_t* aState) { return SplitMix64(*aState); }
+
+// Flip the representation LSB of float 0 and of the ~1/256 floats selected
+// by the keyed stream. dB magnitudes and waveforms do not change audibly or
+// analytically; the bit pattern becomes site-specific.
+void ApplyNoiseFloat(float* aData, uint32_t aCount,
+                     const uint8_t aDomainKey[32], uint32_t aStartIndex) {
+  if (!aData || !aCount) {
+    return;
+  }
+  const uint64_t keyHalf = LoadU64LE(aDomainKey);
+  for (uint64_t i = 0; i < aCount; ++i) {
+    uint64_t state =
+        keyHalf ^ ((i + aStartIndex) * 0x9E3779B97F4A7C15ull);
+    if (i + aStartIndex != 0 && (SplitMix64(state) & 0xFFu) != 0) {
+      continue;
+    }
+    uint32_t bits;
+    memcpy(&bits, &aData[i], sizeof(bits));
+    bits ^= 0x01u;
+    memcpy(&aData[i], &bits, sizeof(bits));
+  }
+}
+
+void ApplyNoise(uint8_t* aPixels, uint32_t aWidth, uint32_t aHeight,
+                const uint8_t aDomainKey[32], uint32_t aBlueOffset) {
+  if (!aPixels || !aWidth || !aHeight || aBlueOffset > 3) {
+    return;
+  }
+  const uint64_t keyHalf = LoadU64LE(aDomainKey);
+  const uint64_t count =
+      static_cast<uint64_t>(aWidth) * static_cast<uint64_t>(aHeight);
+  for (uint64_t i = 0; i < count; ++i) {
+    // Pixel 0 always carries the site key (tiny canvases included);
+    // otherwise ~1/256 of the pixels, chosen by the keyed stream.
+    uint64_t state = keyHalf ^ (i * 0x9E3779B97F4A7C15ull);
+    if (i != 0 && (SplitMix64(state) & 0xFFu) != 0) {
+      continue;
+    }
+    aPixels[i * 4 + aBlueOffset] ^= 0x01;  // blue LSB
+  }
+}
+
+}  // namespace mozilla::dom::AetherCanvasNoise
