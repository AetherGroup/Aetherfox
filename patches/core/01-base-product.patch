diff --git a/browser/branding/aether/pref/firefox-branding.js b/browser/branding/aether/pref/firefox-branding.js
new file mode 100644
index 0000000000000000000000000000000000000000..4801c8bd5ec6548061691dd58dabf52e04807acd
--- /dev/null
+++ b/browser/branding/aether/pref/firefox-branding.js
@@ -0,0 +1,40 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// This file contains branding-specific prefs.
+
+// Aether: news after each update (first run with a new buildID; upstream
+// homepage_override mechanism, opened in the system browser).
+pref("startup.homepage_override_url", "https://aether.browser/news");
+// Aether: local first-run setup, zero network until consent.
+pref("startup.homepage_welcome_url", "about:aether-setup");
+pref("startup.homepage_welcome_url.additional", "");
+// "What's new" (About dialog + Preferences) -> Aether news page.
+// PLACEHOLDER: point this at the real news page when the site has one.
+pref("app.releaseNotesURL", "https://aether.browser/news");
+pref("app.releaseNotesURL.aboutDialog", "https://aether.browser/news");
+pref("app.releaseNotesURL.prompt", "https://aether.browser/news");
+// The time interval between checks for a new version (in seconds)
+pref("app.update.interval", 86400); // 24 hours
+// Give the user x seconds to react before showing the big UI. default=24 hours
+pref("app.update.promptWaitTime", 86400);
+// URL user can browse to manually if for some reason all update installation
+// attempts fail.
+pref("app.update.url.manual", "https://aether.browser");
+// A default value for the "More information about this update" link
+// supplied in the "An update is available" page of the update wizard.
+pref("app.update.url.details", "https://aether.browser");
+
+// The number of days a binary is permitted to be old
+// without checking for an update.  This assumes that
+// app.update.checkInstallTime is true.
+pref("app.update.checkInstallTime.days", 2);
+
+// Give the user x seconds to reboot before showing a badge on the hamburger
+// button. default=immediately
+pref("app.update.badgeWaitTime", 0);
+
+// Number of usages of the web console.
+// If this is less than 5, then pasting code into the web console is disabled
+pref("devtools.selfxss.count", 5);
