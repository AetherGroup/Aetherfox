index b174449a09895020bfda84645b85deebe42c7be8..97e11551a43f96ce21c8a9bef655452402079b9d 100644
--- a/browser/app/distribution/moz.build
+++ b/browser/app/distribution/moz.build
@@ -4,7 +4,13 @@
 
 DIST_SUBDIR = ""
 
-if CONFIG["BUILT_BY_MOZILLA"]:
-    FINAL_TARGET_FILES.distribution += [
-        "distribution.ini",
-    ]
+# Aether: always package distribution files. Upstream only installs these for official builds (BUILT_BY_MOZILLA).
+# No policies.json: zero managed policies.
+FINAL_TARGET_FILES.distribution += [
+    "distribution.ini",
+]
+
+# Aether: bundled extensions. XPIs are staged by aether sync.py from third_party/ (see aether.deps.ini); they install on first run and remain user-removable. No auto-update without consent (aether-services v2).
+FINAL_TARGET_FILES.distribution.extensions += [
+    "extensions/uBlock0@raymondhill.net.xpi",
+]
