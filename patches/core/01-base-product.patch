+
+// ===== Aether Browser =====
+// Kill-switches de privacidad baked-in. La lista completa vive en
+// aether-browser/defaults/prefs/aether.js (overlay de build); aquí only
+// los críticos para que el árbol compile con defaults sanos.
+// Telemetría / Data Reporting OFF (equiv. MOZ_TELEMETRY_REPORTING off)
+pref("toolkit.telemetry.unified", false);
+pref("toolkit.telemetry.enabled", false);
+pref("toolkit.telemetry.archive.enabled", false);
+pref("datareporting.healthreport.service.enabled", false);
+pref("datareporting.healthreport.uploadEnabled", false);
+pref("datareporting.policy.dataSubmissionEnabled", false);
+pref("datareporting.usage.uploadEnabled", false);
+pref("browser.ping-centre.telemetry", false);
+// Normandy / Shield / Studies OFF
+pref("app.normandy.enabled", false);
+pref("app.normandy.first_run", false);
+pref("app.shield.optoutstudies.enabled", false);
+pref("experiments.enabled", false);
+pref("experiments.manifest.uri", "");
+// Telemetry pings OFF (ni unified, ni bhr, ni update, ni shutdown)
+pref("toolkit.telemetry.bhrPing.enabled", false);
+pref("toolkit.telemetry.updatePing.enabled", false);
+pref("toolkit.telemetry.shutdownPingSender.enabled", false);
+pref("toolkit.telemetry.newProfilePing.enabled", false);
+pref("toolkit.telemetry.firstShutdownPing.enabled", false);
+// FOG/Glean OFF (coleccion y subida; ver patch 81 en FOG.cpp)
+pref("telemetry.fog.init_on_shutdown", false);
+// WebCompat reporter OFF (solo gesto de usuario; endpoint dummy en patch 20)
+pref("ui.new-webcompat-reporter.enabled", false);
+pref("ui.new-webcompat-reporter.send-more-info-link", false);
+// Pocket / Sponsored OFF
+pref("extensions.pocket.enabled", false);
+pref("browser.newtabpage.activity-stream.feeds.telemetry", false);
+pref("browser.newtabpage.activity-stream.telemetry", false);
+pref("browser.newtabpage.activity-stream.showSponsored", false);
+pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);
+// Red silenciosa en primer arranque (Dummy-URL pattern)
+pref("network.captive-portal-service.enabled", false);
+pref("network.connectivity-service.enabled", false);
+// Seguridad ON
+pref("dom.security.https_only_mode", true);
+pref("privacy.resistFingerprinting", true);
+// Firefox Accounts / Sync OFF de raiz (ver patch 82: codigo excluido)
+// URLs a dummy + kills. La UI existente toma la rama deshabilitada.
+pref("identity.fxaccounts.enabled", false);
+// Canal de updates local (solo alpha dev): servidor AUS en localhost.
+// Default sobreescribible por el usuario, sin policies ni banner.
+// En release apuntara al AUS productivo.
+pref("app.update.url", "http://127.0.0.1:8000/update/%VERSION%/%BUILD_ID%/update.xml");
+pref("identity.fxaccounts.remote.root", "");
+pref("identity.fxaccounts.remote.profile.uri", "");
+pref("identity.fxaccounts.remote.oauth.uri", "");
+pref("identity.fxaccounts.remote.pairing.uri", "");
+pref("identity.fxaccounts.pairing.enabled", false);
+pref("identity.fxaccounts.telemetry.clientAssociationPing.enabled", false);
+// ===== end Aether =====
