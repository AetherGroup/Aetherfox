diff --git a/browser/components/aether/content/setup.html b/browser/components/aether/content/setup.html
new file mode 100644
index 0000000000000000000000000000000000000000..bb2524dec62519b0b0e9a582f6676fdc82346cfd
--- /dev/null
+++ b/browser/components/aether/content/setup.html
@@ -0,0 +1,101 @@
+<!DOCTYPE html>
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+<!-- Aether first-run setup. Fully local: inline CSS/JS only,
+   zero network requests until the user explicitly enables a service. -->
+<html>
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Aetherfox Setup</title>
+<link rel="icon" href="chrome://branding/content/setup-icon.png">
+<style>
+  :root { color-scheme: dark; }
+  body { background: #130829; color: #fff; font: 15px/1.5 "Segoe UI", system-ui, sans-serif; margin: 0; }
+  main { max-width: 560px; margin: 8vh auto; padding: 0 24px; }
+  .brand { display: flex; align-items: center; gap: 14px; margin-bottom: 2px; }
+  .brand img { border-radius: 18px; }
+  h1 { font-size: 28px; margin: 0 0 4px; }
+  .sub { color: #b9b9d0; margin-bottom: 24px; }
+  .card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
+          border-radius: 12px; padding: 16px 20px; margin-bottom: 12px; }
+  .card label { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; }
+  .card input[type=checkbox] { width: 18px; height: 18px; margin-top: 2px; accent-color: #4da3ff; }
+  .card .t { font-weight: 600; }
+  .card .d { color: #b9b9d0; font-size: 13px; }
+  .row { display: flex; gap: 8px; margin-top: 8px; }
+  input[type=text] { flex: 1; background: #0c0618; color: #fff; border: 1px solid rgba(255,255,255,.2);
+                     border-radius: 8px; padding: 8px 10px; font: inherit; }
+  button { background: #4da3ff; color: #06121f; border: 0; border-radius: 8px;
+           padding: 10px 22px; font: inherit; font-weight: 600; cursor: pointer; }
+  button:hover { background: #7dbdff; }
+  .note { color: #b9b9d0; font-size: 13px; margin-top: 16px; }
+  #status { margin-top: 12px; font-weight: 600; display: none; }
+</style>
+</head>
+<body>
+<main>
+<div class="brand"><img src="chrome://branding/content/setup-icon.png" alt="" width="72" height="72"><h1>Aetherfox Setup</h1></div>
+  <div class="sub">Private by default. Nothing below talks to the network until you say so.
+    Services schema <b>v1</b>.</div>
+
+  <div class="card"><label><input type="checkbox" id="opt-updates">
+    <span><span class="t">Browser updates</span><br>
+    <span class="d">Check the Aetherfox update endpoint for new versions. Off by default in v1.</span></span></label></div>
+
+  <div class="card"><label><input type="checkbox" id="opt-ublock">
+    <span><span class="t">uBlock filter lists</span><br>
+    <span class="d">Refresh blocker lists through the Aetherfox proxy instead of third parties.</span></span></label></div>
+
+  <div class="card"><label><input type="checkbox" id="opt-sync">
+    <span><span class="t">Sync</span><br>
+    <span class="d">Sync bookmarks and settings via your own Aetherfox services endpoint.</span></span></label></div>
+
+  <div class="card"><span class="t">Services endpoint (optional, self-hostable)</span><br>
+    <span class="d">Leave empty to use the default endpoint when it exists. You can change this at any time before any request is made.</span>
+    <div class="row"><input type="text" id="opt-origin" placeholder="https://services.aether.browser"></div></div>
+
+  <div class="row"><button id="save">Save &amp; continue</button></div>
+  <div id="status">Saved. No requests were made.</div>
+  <div class="note">Aetherfox makes zero web requests on first launch. Enabling a service above is explicit consent;
+    each service stays off unless checked. Legal documents live in the public repo with full history.
+    <br><a href="about:aether-changelog" style="color:#4da3ff">Novedades de esta versi├│n</a> (solo se muestra si la abres t├║).</div>
+</main>
+<script>
+const { Services } = ChromeUtils.importESModule("resource://gre/modules/Services.sys.mjs");
+const P = {
+  master: "services.aether.enabled",
+  updates: "services.aether.updates.enabled",
+  ublock: "services.aether.ublock.enabled",
+  sync: "services.aether.sync.enabled",
+  origin: "services.aether.origin",
+  schema: "services.aether.schemaVersion",
+  ack: "services.aether.acknowledged",
+};
+function load() {
+  const g = (k, dflt) => { try { return Services.prefs.getBoolPref(k); } catch { return dflt; } };
+  document.getElementById("opt-updates").checked = g(P.updates, false);
+  document.getElementById("opt-ublock").checked = g(P.ublock, false);
+  document.getElementById("opt-sync").checked = g(P.sync, false);
+  try { document.getElementById("opt-origin").value = Services.prefs.getCharPref(P.origin); } catch {}
+}
+document.getElementById("save").addEventListener("click", () => {
+  const u = document.getElementById("opt-updates").checked;
+  const b = document.getElementById("opt-ublock").checked;
+  const s = document.getElementById("opt-sync").checked;
+  Services.prefs.setBoolPref(P.updates, u);
+  Services.prefs.setBoolPref(P.ublock, b);
+  Services.prefs.setBoolPref(P.sync, s);
+  Services.prefs.setBoolPref(P.master, u || b || s);
+  const origin = document.getElementById("opt-origin").value.trim();
+  if (origin) { Services.prefs.setCharPref(P.origin, origin); }
+  Services.prefs.setIntPref(P.schema, 1);
+  Services.prefs.setBoolPref(P.ack, true);
+  const st = document.getElementById("status");
+  st.style.display = "block";
+});
+load();
+</script>
+</body>
+</html>
