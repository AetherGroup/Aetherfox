+// Loaded version of one list for the row badge: "" when unknown, "Off"
+// when the list is switched off, the raw version otherwise.
+function listKnownVersion(key) {
+  try {
+    const { AetherBlocker } = ChromeUtils.importESModule(
+      "resource://gre/modules/AetherBlocker.sys.mjs"
+    );
+    const info = AetherBlocker.updateInfo();
+    const v = info.versions && info.versions[key];
+    if (!v || v === "pending") {
+      return "";
+    }
+    return v === "off" ? "Off" : v;
+  } catch (e) {
+    return "";
+  }
+}
+
+function setListBadge(btn, key, res) {
+  const row = btn.closest(".row");
+  const sm = row ? row.querySelector(".t > small") : null;
+  if (!sm) {
+    return;
+  }
+  if (key.startsWith("custom-")) {
+    const e = customListsNow().find(x => x.key === key);
+    if (!e) {
+      return;
+    }
+    const v = (res && res.version) || listKnownVersion(key);
+    const st = !res
+      ? "Update failed"
+      : res.changed === false
+        ? "Already up to date"
+        : "Updated just now";
+    sm.textContent = e.url + (v ? " · " + v : "") + " · " + st;
+    return;
+  }
+  let badge = sm.querySelector(".listver");
+  if (!badge) {
+    badge = document.createElement("span");
+    badge.className = "listver";
+    badge.dataset.key = key;
+    sm.appendChild(badge);
+  }
+  if (!res) {
+    const cur = badge.textContent.replace(/ · Update failed$/, "");
+    badge.textContent = cur + " · Update failed";
+    return;
+  }
+  const v = res.version || listKnownVersion(key);
+  const st =
+    res.changed === false ? "Already up to date" : "Updated just now";
+  badge.textContent = (v ? " · " + v : "") + " · " + st;
