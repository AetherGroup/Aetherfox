-      - GFX_PRINTER_NAME_NOT_FOUND
-      - GFX_PRINTER_COULD_NOT_OPEN_FILE
-      - GFX_PRINTER_STARTDOC
-      - GFX_PRINTER_ENDDOC
-      - GFX_PRINTER_STARTPAGE
-      - GFX_PRINTER_DOC_IS_BUSY
-      - ABORT
-      - NOT_AVAILABLE
-      - NOT_IMPLEMENTED
