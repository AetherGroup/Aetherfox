-      - LAST_USED_PRINTER
-      - PAPER_MARGINS
-      - PRINT_DESTINATIONS
-      - PRINT_PREVIEW
-      - PRINTER_LIST
-      - PRINTER_PROPERTIES
-      - PRINTER_SETTINGS
-      - UNWRITEABLE_MARGIN
-    telemetry_mirror: PRINTING_ERROR
-
