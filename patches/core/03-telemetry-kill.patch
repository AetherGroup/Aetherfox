-    notification_emails:
-      - gfx-telemetry-alerts@mozilla.com
-      - botond@mozilla.com
-    expires: never
-
-  severity:
-    type: custom_distribution
-    range_max: 1073741824
-    bucket_count: 50
-    histogram_type: exponential
-    unit: Opaque unit
-    description: >
-      An opaque measurement of the severity of a checkerboard event.
