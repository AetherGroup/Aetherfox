-  /**
-   * Make parent process the first one, content process the second
-   * then sort processes alphabetically
-   */
-  static processesComparator(a, b) {
-    if (a === "parent" || (a === "content" && b !== "parent")) {
-      return -1;
-    } else if (b === "parent" || b === "content") {
-      return 1;
-    } else if (a < b) {
-      return -1;
-    } else if (a > b) {
-      return 1;
-    }
-    return 0;
-  }
