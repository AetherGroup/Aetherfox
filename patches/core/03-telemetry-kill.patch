-      - network_wifi_and_ip
-      - network_ip
-    bugs:
-      - https://bugzilla.mozilla.org/show_bug.cgi?id=2046658
-    data_reviews:
-      - https://bugzilla.mozilla.org/show_bug.cgi?id=2046658
-    notification_emails:
-      - daparks@mozilla.com
-    expires: never
