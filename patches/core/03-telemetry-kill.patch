-      return 17;
-    // mozilla::pkix::MOZILLA_PKIX_ERROR_ADDITIONAL_POLICY_CONSTRAINT_FAILED was
-    // 18
-    case mozilla::pkix::MOZILLA_PKIX_ERROR_SELF_SIGNED_CERT:
-      return 19;
-    case mozilla::pkix::MOZILLA_PKIX_ERROR_MITM_DETECTED:
