-  await initSinglePageAppTest({
-    baseProviderOverrides: { requireTopLevelImpressionOrigin: true },
-  });
-
-  registerCleanupFunction(async () => {
-    SearchSERPTelemetry.overrideSearchTelemetryForTests();
-    resetTelemetry();
-  });
-});
