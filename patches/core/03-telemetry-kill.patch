-async function syncCollection(record) {
-  let arrayWithRecord = record ? [record] : [];
-  await RemoteSettings(TELEMETRY_CATEGORIZATION_KEY).emit("sync", {
-    data: {
-      current: arrayWithRecord,
-      created: arrayWithRecord,
-      updated: [],
-      deleted: [],
-    },
-  });
-}
