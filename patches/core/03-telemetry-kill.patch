@@ -1010,10 +1010,26 @@ set_define("MOZ_BUILD_APP", build_project)
 option(env="MOZILLA_OFFICIAL", help="Build an official release")
 
 
+# Aether: this is the single guarantee that telemetry cannot be switched on, and
+# it is deliberately not just "we do not set the variable". Two independent
+# mechanisms hang off it:
+#   1. the MOZ_TELEMETRY_REPORTING / MOZ_TELEMETRY_ON_BY_DEFAULT C++ macros
+#      (toolkit/moz.configure), which compile the legacy telemetry code out;
+#   2. gkrust's glean_disable_upload feature (gkrust-features.mozbuild), which
+#      is the one that actually stops pings leaving the machine: the uploader
+#      short-circuits and returns a fake HTTP 200 without touching the network.
+# MOZILLA_OFFICIAL is settable with a plain environment variable and 81 files
+# read it, so a single MOZILLA_OFFICIAL=1 in the shell would bring both back.
+# Returning None unconditionally makes the variable irrelevant. It must be
+# None and not False: every CONFIG consumer uses it as a boolean (same
+# either way), but set_define(False) emits -DMOZILLA_OFFICIAL empty while
+# set_define(None) leaves the macro undefined. False split the levels:
+# JS saw unofficial while the C preprocessor saw official, so official-only
+# C++ compiled in and #ifndef-guarded files (browser-development-helpers.js)
+# were not packaged while browser-main.js still tried to load them.
 @depends("MOZILLA_OFFICIAL")
 def mozilla_official(official):
-    if official:
-        return True
+    return None
 
 
 set_config("MOZILLA_OFFICIAL", mozilla_official)
