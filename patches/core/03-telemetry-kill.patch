-  static withRateLimits(sampleRates, callback) {
-    const flowContext = TranslationsTelemetry.getOrCreateFlowContext();
-
-    if (TranslationsTelemetry.shouldSkipSample(sampleRates, flowContext)) {
-      return;
-    }
