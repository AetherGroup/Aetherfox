-    range_max: 1000
-    bucket_count: 100
-    histogram_type: exponential
-    unit: tabs
-    bugs:
-      - https://bugzilla.mozilla.org/show_bug.cgi?id=1361855
-      - https://bugzilla.mozilla.org/show_bug.cgi?id=1488945
-    data_reviews:
