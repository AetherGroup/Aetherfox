-  Services.fog.testResetFOG();
-  bs.onUpdateScheduledBackups(true);
-  Assert.equal(
-    Glean.browserBackup.schedulerToggleSource.testGetValue(),
-    "unknown",
-    "Stashed source is consumed once; subsequent toggles default to 'unknown'."
-  );
-
-  // Clean up.
