-        // Prepare an FfiResult with an empty response
-        let (sender, receiver) = oneshot::channel();
-        let mut result = Box::new(FfiResult {
-            sender: Some(sender),
-            response: Response {
-                request_method: request.method,
-                url: request.url.clone(),
-                status: 0,
-                headers: viaduct::Headers::new(),
