-    let ranks = prefs.trainhopConfig?.sections?.adAllowedRanks;
-    if (!Array.isArray(ranks)) {
-      const pref = prefs[PREF_SECTIONS_AD_ALLOWED_RANKS];
-      ranks = pref ? pref.split(",").map(Number) : undefined;
