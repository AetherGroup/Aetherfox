-bool internal_CanRecordProcess(const StaticMutexAutoLock& lock,
-                               const ScalarKey& aId) {
-  const BaseScalarInfo& info = internal_GetScalarInfo(lock, aId);
-  return CanRecordInProcess(info.record_in_processes, XRE_GetProcessType());
