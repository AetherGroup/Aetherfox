-static void RecordStackWalker(uint32_t aFrameNumber, void* aPC, void* aSP,
-                              void* aClosure) {
-  std::vector<uintptr_t>* stack =
-      static_cast<std::vector<uintptr_t>*>(aClosure);
-  stack->push_back(reinterpret_cast<uintptr_t>(aPC));
-}
