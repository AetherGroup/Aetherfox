-template <typename EntryType>
-bool AutoHashtable<EntryType>::ReflectIntoJS(ReflectEntryFunc entryFunc,
-                                             JSContext* cx,
-                                             JS::Handle<JSObject*> obj) {
-  for (auto iter = this->Iter(); !iter.Done(); iter.Next()) {
-    if (!entryFunc(iter.Get(), cx, obj)) {
-      return false;
-    }
-  }
-  return true;
-}
