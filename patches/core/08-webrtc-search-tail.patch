+/**
+ * Promise handler used to discard the result of re-translating a document after
+ * the application locales changed.
+ *
+ * A resource that is not available in the newly selected locale leaves the
+ * affected elements untranslated, which makes the root translation reject with
+ * no value. Nothing can act on that, and document.l10n.ready deliberately
+ * resolves in the very same situation (see L10nReadyHandler in
+ * DocumentL10n.cpp), so leaving this promise unobserved would only add a bare
+ * "uncaught exception: undefined" to the console every time the user switches
+ * language.
+ */
+class L10nOnChangeHandler final : public PromiseNativeHandler {
+ public:
+  NS_DECL_THREADSAFE_ISUPPORTS
+
+  void ResolvedCallback(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                        ErrorResult& aRv) override {}
+
+  void RejectedCallback(JSContext* aCx, JS::Handle<JS::Value> aValue,
+                        ErrorResult& aRv) override {}
+
+ private:
+  ~L10nOnChangeHandler() = default;
+};
+
+NS_IMPL_ISUPPORTS0(L10nOnChangeHandler)
+
 void DOMLocalization::OnChange() {
   Localization::OnChange();
