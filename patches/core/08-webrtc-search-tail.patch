-  JS::Rooted<JSObject*> rarray(aCx, JS::NewArrayObject(aCx, allStores));
-  if (rarray == nullptr) {
-    return NS_ERROR_FAILURE;
-  }
-  aResult.setObject(*rarray);
-
-  return NS_OK;
