-//   internal_JSKeyedHistogram_Keys
-//   internal_JSKeyedHistogram_Snapshot
-//   internal_JSKeyedHistogram_Clear
-//   internal_WrapAndReturnKeyedHistogram
-//
-// Same comments as above, at the JSHistogram_* section, regarding
