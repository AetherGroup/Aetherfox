-      await this.rustBackend?.dismissRustSuggestion(
-        result.payload.suggestionObject
-      );
-    } else {
-      let key = getDismissalKey(result);
-      if (key) {
-        await this.rustBackend?.dismissByKey(key);
-      }
-    }
