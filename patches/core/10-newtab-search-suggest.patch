-
-    // Set up the Merino session ID and related state. The session ID is a UUID
-    // without leading and trailing braces.
-    if (!this.#sessionID) {
-      let uuid = Services.uuid.generateUUID().toString();
-      this.#sessionID = uuid.substring(1, uuid.length - 1);
