-  Assert.ok(
-    UrlbarTelemetryUtils.exposureTerminal(result, null, visible),
-    "a visible result is terminal"
-  );
-  Assert.ok(
-    !UrlbarTelemetryUtils.exposureTerminal(
-      makeResult("https://example.com/gone"),
-      null,
