-      case "merino":
-        return this.#featuresByMerinoProvider.get(provider);
-      case "rust":
-        if (provider == "Dynamic" && suggestionType) {
-          let dynamicFeature =
-            this.#featuresByDynamicRustSuggestionType.get(suggestionType);
-          if (dynamicFeature) {
-            return dynamicFeature;
-          }
-        }
