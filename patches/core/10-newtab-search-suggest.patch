- * @param {int} wordCount number of words in an article
- * @returns {int} number of words per minute in minutes
- */
-export function readTimeFromWordCount(wordCount) {
-  if (!wordCount) {
-    return false;
-  }
-  return Math.ceil(parseInt(wordCount, 10) / READING_WPM);
-}
