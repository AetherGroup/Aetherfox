-  // Make sure all urls are of the allowed protocols/prefixes
-  const urls = value.match(/url\("[^"]+"\)/g);
-  return (
-    !urls ||
-    urls.every(url =>
-      ALLOWED_CSS_URL_PREFIXES.some(prefix => url.slice(5).startsWith(prefix))
-    )
-  );
-}
