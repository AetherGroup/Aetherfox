-      this.#fetchController?.abort();
-    } catch (error) {
-      this.#lazy.logger.error("Error aborting previous fetch", error);
-    }
-
-    // Do the fetch.
-    /** @type {?OHTTPResponse|?Response} */
-    let response;
-    let controller = (this.#fetchController = new AbortController());
