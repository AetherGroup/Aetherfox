-function liveHiddenAction(portId) {
-  return {
-    type: actionTypes.WIDGETS_SPORTS_LIVE_HIDDEN,
-    meta: { fromTarget: portId },
-  };
-}
-
-function newTabUnloadAction(portId) {
-  return {
-    type: actionTypes.NEW_TAB_UNLOAD,
-    meta: { fromTarget: portId },
-  };
-}
