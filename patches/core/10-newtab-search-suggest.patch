-      // This entry is the search suggestion we're looking for.
-      let element = await UrlbarTestUtils.waitForAutocompleteResultAt(
-        window,
-        i
-      );
-      if (button == 1) {
-        EventUtils.synthesizeMouseAtCenter(element, {});
